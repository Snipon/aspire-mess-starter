---
import AlertTriangleIcon from '@tabler/icons/outline/alert-triangle.svg';
import CircleCheckIcon from '@tabler/icons/outline/circle-check.svg';
import CircleXIcon from '@tabler/icons/outline/circle-x.svg';
import HelpCircleIcon from '@tabler/icons/outline/help-circle.svg';
import { Alert, AlertTitle } from '@/components/starwind/alert';
import { Badge } from '@/components/starwind/badge';
import { Card } from '@/components/starwind/card';
import type { Row, State } from '@/lib/status';
import { cn } from '@/lib/utils';

interface Props {
  overall: State;
  rows: Row[];
}

const { overall, rows } = Astro.props;

const labels: Record<State, string> = { healthy: 'Operational', degraded: 'Degraded', unhealthy: 'Down', unknown: 'Unknown' };
const headlines: Record<State, string> = {
  healthy: 'All systems operational',
  degraded: 'Some systems are degraded',
  unhealthy: 'Some systems are down',
  unknown: 'System status unknown',
};
const icons = {
  healthy: CircleCheckIcon,
  degraded: AlertTriangleIcon,
  unhealthy: CircleXIcon,
  unknown: HelpCircleIcon,
} satisfies Record<State, unknown>;
// Status colours have no theme token: one strong hue per state for the edge bar and icon, on flat panel surfaces.
// The icon hues are !important to beat the Alert's svg text-current.
const bars: Record<State, string> = {
  healthy: 'border-l-emerald-600',
  degraded: 'border-l-amber-500',
  unhealthy: 'border-l-destructive',
  unknown: 'border-l-input',
};
const hues: Record<State, string> = {
  healthy: 'text-emerald-700!',
  degraded: 'text-amber-700!',
  unhealthy: 'text-destructive!',
  unknown: 'text-muted-foreground!',
};
const OverallIcon = icons[overall];
---

<Alert role="status" class={cn('mt-8 border-l-8 px-5 py-5 *:[svg]:translate-y-1', bars[overall])}>
  <OverallIcon aria-hidden="true" class={cn('size-6!', hues[overall])} />
  <AlertTitle class="text-xl font-medium sm:text-2xl">{headlines[overall]}</AlertTitle>
</Alert>

<Card class="mt-6 gap-0 py-0">
  <ul class="divide-y">
    {
      rows.map((row) => {
        const Icon = icons[row.state];
        return (
          <li class="flex items-center justify-between gap-4 px-5 py-4">
            <div class="min-w-0">
              <p class="font-semibold">{row.name}</p>
              <p class="text-sm text-muted-foreground">{row.detail}</p>
            </div>
            <Badge variant="secondary" class="h-7 gap-1.5 px-2.5 text-sm">
              <Icon aria-hidden="true" class={cn('size-4!', hues[row.state])} />
              {labels[row.state]}
            </Badge>
          </li>
        );
      })
    }
  </ul>
</Card>
