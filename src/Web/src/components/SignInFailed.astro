---
import { ButtonVariants } from '@/components/starwind/button';
import Layout from '../layouts/Layout.astro';

interface Props {
  /** Where "Try again" starts a new sign-in. */
  retryHref: string;
  detail: string;
}

const { retryHref, detail } = Astro.props;
---

<Layout title="Sign-in failed" noindex>
  <section class="mx-auto max-w-610">
    <h1 class="text-34 font-medium">Sign-in did not complete</h1>
    <p class="mt-13 text-21 text-muted-foreground">{detail}</p>
    <a href={retryHref} class={ButtonVariants.button({ size: 'lg', class: 'mt-34' })}>Try again</a>
  </section>
</Layout>
