---
import { Input } from '@/components/ui/input';

/** A `q` search input with autosuggest (combobox over /api/suggest); without JavaScript it is a plain search field. */
interface Props {
  id: string;
  value?: string;
  placeholder?: string;
  autofocus?: boolean;
  class?: string;
}

const { id, value, placeholder, autofocus, class: className } = Astro.props;
const listId = `${id}-suggestions`;
---

<div class="relative" data-search-suggest>
  <Input
    id={id}
    type="search"
    name="q"
    defaultValue={value}
    placeholder={placeholder}
    autoFocus={autofocus}
    className={className}
    autoComplete="off"
    role="combobox"
    aria-autocomplete="list"
    aria-expanded="false"
    aria-controls={listId}
  />
  <ul
    id={listId}
    role="listbox"
    aria-label="Suggestions"
    hidden
    class="absolute top-full right-0 z-20 mt-1 w-full min-w-72 overflow-hidden rounded-none border border-ink bg-popover text-sm text-popover-foreground"
  >
  </ul>
</div>

<script>
  import type { Suggestion } from '../pages/api/suggest';

  const DEBOUNCE_MS = 150;

  for (const root of document.querySelectorAll<HTMLElement>('[data-search-suggest]')) {
    const input = root.querySelector('input')!;
    const list = root.querySelector('ul')!;
    let items: Suggestion[] = [];
    let active = -1;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let controller: AbortController | undefined;

    const render = () => {
      list.replaceChildren(
        ...items.map((item, i) => {
          const option = document.createElement('li');
          option.id = `${list.id}-${i}`;
          option.role = 'option';
          option.ariaSelected = String(i === active);
          option.className =
            'group flex cursor-pointer items-baseline justify-between gap-3 px-3 py-2 font-medium hover:bg-muted aria-selected:bg-primary aria-selected:text-primary-foreground';
          const title = document.createElement('span');
          title.className = 'min-w-0 truncate';
          title.textContent = item.title;
          const type = document.createElement('span');
          type.className = 'font-narrow shrink-0 text-xs text-muted-foreground group-aria-selected:text-primary-foreground/80';
          type.textContent = item.contentType;
          option.append(title, type);
          // mousedown, not click: fires before the input's blur closes the list.
          option.addEventListener('mousedown', (event) => {
            event.preventDefault();
            location.href = item.path;
          });
          return option;
        }),
      );
      list.hidden = items.length === 0;
      input.ariaExpanded = String(items.length > 0);
      if (active >= 0) input.setAttribute('aria-activedescendant', `${list.id}-${active}`);
      else input.removeAttribute('aria-activedescendant');
    };

    const close = () => {
      clearTimeout(timer);
      controller?.abort();
      items = [];
      active = -1;
      render();
    };

    input.addEventListener('input', () => {
      const q = input.value.trim();
      close();
      if (q.length < 2) return;
      timer = setTimeout(async () => {
        controller = new AbortController();
        try {
          const response = await fetch(`/api/suggest?${new URLSearchParams({ q })}`, { signal: controller.signal });
          items = response.ok ? await response.json() : [];
          render();
        } catch {
          // Aborted by newer input, or offline: the form still submits normally.
        }
      }, DEBOUNCE_MS);
    });

    input.addEventListener('keydown', (event) => {
      if (list.hidden) return;
      const count = items.length;
      if (event.key === 'ArrowDown') active = (active + 1) % count;
      else if (event.key === 'ArrowUp') active = active <= 0 ? count - 1 : active - 1;
      else if (event.key === 'Enter' && active >= 0) location.href = items[active].path;
      else if (event.key === 'Escape') close();
      else return;
      event.preventDefault();
      render();
    });

    input.addEventListener('blur', close);
  }
</script>
