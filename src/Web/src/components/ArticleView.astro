---
import ArticleCard from '@/components/ArticleCard';
import ProductCard from '@/components/ProductCard';
import ResponsiveImage from '@/components/ResponsiveImage';
import TagList from '@/components/TagList';
import { Separator } from '@/components/ui/separator';
import type { Article, BlogPost, Page } from '../lib/api/client';
import { formatDate } from '../lib/format';

interface Props {
  page: Page;
  /** An article, or a blog post (no tags, optionally a related article). */
  article: Article | BlogPost;
}

const { page, article } = Astro.props;
const tags = 'tags' in article ? article.tags : [];
const related = 'relatedArticle' in article ? article.relatedArticle : null;
const product = 'product' in article ? article.product : null;
// Articles live below their listing page (e.g. /articles/my-post → /articles).
const parentPath = page.path.replace(/\/[^/]+\/?$/, '') || '/';
---

<article>
  <header class="mx-auto max-w-3xl">
    <nav aria-label="Breadcrumb">
      <a href={parentPath} class="back-link">
        {page.contentType === 'blogPost' ? 'All blog posts' : 'All articles'}
      </a>
    </nav>
    <h1 class="mt-6 text-4xl leading-tight font-medium text-balance sm:text-5xl lg:text-6xl">{page.title}</h1>
    {/* A div, not a p: the separator renders a div, which would close a p early. */}
    <div class="mt-8 flex items-center gap-3 border-t border-border pt-3 text-sm text-muted-foreground">
      <time datetime={article.publishDate}>{formatDate(article.publishDate)}</time>
      <Separator orientation="vertical" className="h-4 self-center!" />
      <span>{article.readingTimeMinutes} min read</span>
    </div>
    <TagList tags={tags} className="mt-4" />
  </header>

  {
    page.image && (
      <figure class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-lg bg-muted">
        <ResponsiveImage
          image={page.image}
          loading="eager"
          sizes="(min-width: 960px) 896px, 100vw"
          className="aspect-video w-full object-cover"
        />
      </figure>
    )
  }

  <div
    class="prose prose-lg mx-auto mt-12 max-w-3xl"
    set:html={article.bodyHtml}
  />

  {
    product && (
      <aside aria-labelledby="featured-product" class="mx-auto mt-14 max-w-3xl">
        <h2 id="featured-product" class="border-t border-border pt-3 text-2xl font-medium">Featured product</h2>
        <div class="mt-6 flex max-w-xs">
          <ProductCard product={product} />
        </div>
      </aside>
    )
  }

  {
    related && (
      <aside aria-labelledby="related-article" class="mx-auto mt-14 max-w-3xl">
        <h2 id="related-article" class="border-t border-border pt-3 text-2xl font-medium">Read the full article</h2>
        <div class="mt-6 flex max-w-sm">
          <ArticleCard article={related} />
        </div>
      </aside>
    )
  }
</article>
