---
import ArticleCard from '@/components/ArticleCard.astro';
import ProductCard from '@/components/ProductCard.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import TagList from '@/components/TagList.astro';
import { Separator } from '@/components/starwind/separator';
import type { Article, BlogPost, Page } from '../lib/api/client';
import { focusableScrollers, formatDate } from '../lib/format';

interface Props {
  page: Page;
  /** An article, or a blog post (no tags, optionally a related article). */
  article: Article | BlogPost;
}

const { page, article } = Astro.props;
const tags = 'tags' in article ? article.tags : [];
const related = 'relatedArticle' in article ? article.relatedArticle : null;
const product = 'product' in article ? article.product : null;
// Articles live below their listing page (e.g. /articles/my-post → /articles).
const parentPath = page.path.replace(/\/[^/]+\/?$/, '') || '/';
---

<article>
  <div data-reading-progress aria-hidden="true" class="fixed inset-x-0 top-0 z-20 hidden h-3 origin-left bg-primary"></div>
  <header class="mx-auto max-w-610">
    <nav aria-label="Breadcrumb">
      <a href={parentPath} class="back-link">
        {page.contentType === 'blogPost' ? 'All blog posts' : 'All articles'}
      </a>
    </nav>
    <h1 class="mt-21 text-34 leading-tight font-medium text-balance sm:text-55">{page.title}</h1>
    {/* A div, not a p: the separator renders a div, which would close a p early. */}
    <div class="mt-34 flex items-center gap-13 border-t border-border pt-13 text-13 text-muted-foreground">
      <time datetime={article.publishDate}>{formatDate(article.publishDate)}</time>
      <Separator orientation="vertical" class="h-13 self-center!" />
      <span>{article.readingTimeMinutes} min read</span>
    </div>
    <TagList tags={tags} class="mt-13" />
  </header>

  {
    page.image && (
      <figure class="mx-auto mt-34 max-w-987 overflow-hidden rounded-5 bg-muted">
        <ResponsiveImage
          image={page.image}
          loading="eager"
          sizes="(min-width: 960px) 896px, 100vw"
          class="aspect-video w-full object-cover"
        />
      </figure>
    )
  }

  <div
    class="prose prose-lg mx-auto mt-55 max-w-610"
    set:html={focusableScrollers(article.bodyHtml)}
  />

  {
    product && (
      <aside aria-labelledby="featured-product" class="mx-auto mt-55 max-w-610">
        <h2 data-reveal id="featured-product" class="border-t border-border pt-13 text-21 font-medium">Featured product</h2>
        <div class="mt-21 flex max-w-377">
          <ProductCard product={product} />
        </div>
      </aside>
    )
  }

  {
    related && (
      <aside aria-labelledby="related-article" class="mx-auto mt-55 max-w-610">
        <h2 data-reveal id="related-article" class="border-t border-border pt-13 text-21 font-medium">Read the full article</h2>
        <div class="mt-21 flex max-w-377">
          <ArticleCard article={related} />
        </div>
      </aside>
    )
  }
</article>
