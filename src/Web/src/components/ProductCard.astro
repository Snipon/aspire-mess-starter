---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { Badge } from '@/components/starwind/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/starwind/card';
import type { ProductSummary } from '@/lib/api/client';
import { formatMoney, formatNumber } from '@/lib/format';

interface Props {
  product: ProductSummary;
}

const { product } = Astro.props;
---

<Card data-reveal class="group relative w-full pt-0 transition-colors hover:border-muted-foreground focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring">
  <div class="aspect-[4/3] overflow-hidden bg-muted">
    {
      product.image && (
        <ResponsiveImage
          image={{ ...product.image, alt: null }}
          sizes="(min-width: 1024px) 240px, (min-width: 640px) 33vw, 50vw"
          class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-377 motion-safe:ease-out motion-safe:group-hover:scale-103"
        />
      )
    }
  </div>
  <CardHeader>
    <CardDescription>
      <span class="font-semibold text-foreground">{product.brand}</span>{' '}{product.category}
    </CardDescription>
    <CardTitle class="text-16 leading-snug font-medium text-balance">
      <h3>
        <a
          href={product.path}
          class="decoration-primary decoration-1 underline-offset-4 after:absolute after:inset-0 focus-visible:outline-none group-hover:underline"
        >
          {product.title}
        </a>
      </h3>
    </CardTitle>
  </CardHeader>
  <CardContent class="mt-auto flex flex-wrap items-center justify-between gap-8">
    <span class="text-21 font-medium tabular-nums">{formatMoney(product.price)}</span>
    <span class="text-13 text-muted-foreground">
      <span aria-hidden="true">★</span>{' '}{product.rating.toFixed(1)}
      <span class="sr-only"> out of 5</span> ({formatNumber(product.reviewCount)})
    </span>
    {!product.inStock && <Badge variant="rose">Out of stock</Badge>}
  </CardContent>
</Card>
