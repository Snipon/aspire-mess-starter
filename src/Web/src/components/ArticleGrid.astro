---
import ArticleCard from '@/components/ArticleCard.astro';
import type { ArticleSummary } from '@/lib/api/client';

interface Props {
  articles: ArticleSummary[];
  headingLevel?: 'h2' | 'h3';
}

const { articles, headingLevel } = Astro.props;
---

<ul data-stagger class="grid gap-21 sm:grid-cols-2 lg:grid-cols-3">
  {
    articles.map((article) => (
      <li class="flex">
        <ArticleCard article={article} headingLevel={headingLevel} />
      </li>
    ))
  }
</ul>
