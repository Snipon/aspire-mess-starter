---
import type { Image } from '../lib/api/client';

interface Props {
  image: Image;
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { image, sizes = '(min-width: 1024px) 1024px, 100vw', class: className, loading = 'lazy' } = Astro.props;
const srcset = image.srcset.length ? image.srcset.map((r) => `${r.url} ${r.width}w`).join(', ') : undefined;
// Prefer the largest signed rendition over the original upload as the fallback src.
const src = image.srcset.at(-1)?.url ?? image.url;
const objectPosition = image.focalPoint
  ? `${image.focalPoint.left * 100}% ${image.focalPoint.top * 100}%`
  : undefined;
---

<img
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  width={image.width ?? undefined}
  height={image.height ?? undefined}
  alt={image.alt ?? ''}
  loading={loading}
  decoding="async"
  class={className}
  style={objectPosition ? `object-position: ${objectPosition}` : undefined}
/>
