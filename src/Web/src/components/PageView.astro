---
import Layout from '../layouts/Layout.astro';
import ArticleView from './ArticleView.astro';
import BlockList from './blocks/BlockList.astro';
import type { Page } from '../lib/api/client';
import { cardImageUrl } from '../lib/image';
import { siteUrl } from '../lib/site';
import { articleJsonLd } from '../lib/structured-data';

interface Props {
  page: Page;
  /** Shown above the page, e.g. on the staff preview. */
  banner?: string;
  /** Keeps the page out of search engines (drafts). */
  noindex?: boolean;
}

const { page, banner, noindex } = Astro.props;

// Landing pages often have no summary; their hero's subheading describes them just as well.
const hero = page.blocks.find((block) => block.type === 'hero');
const description = page.summary ?? hero?.subheading;
const image = page.image ?? hero?.image;
const article = page.article ?? page.blogPost;
const structuredData = article && !noindex ? [articleJsonLd(page, article, siteUrl(Astro.url), image ? cardImageUrl(image) : undefined)] : undefined;
---

<Layout
  title={page.title}
  description={description}
  cmsId={page.id}
  {image}
  type={article ? 'article' : 'website'}
  {noindex}
  {structuredData}
>
  {banner && <p role="status" class="mb-34 bg-primary px-13 py-8 text-13 font-semibold text-primary-foreground">{banner}</p>}
  {
    article ? (
      <ArticleView page={page} article={article} />
    ) : (
      <>
        {page.blocks[0]?.type !== 'hero' && (
          <header class="mb-55 border-b border-border pb-34">
            <h1 class="max-w-987 text-34 leading-tight font-medium text-balance sm:text-55">{page.title}</h1>
            {page.summary && <p class="mt-21 max-w-610 font-serif text-21 leading-relaxed text-pretty text-muted-foreground">{page.summary}</p>}
          </header>
        )}
        <BlockList blocks={page.blocks} />
      </>
    )
  }
</Layout>
