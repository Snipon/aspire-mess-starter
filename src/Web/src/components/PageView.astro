---
import Layout from '../layouts/Layout.astro';
import ArticleView from './ArticleView.astro';
import BlockList from './blocks/BlockList.astro';
import type { Page } from '../lib/api/client';

interface Props {
  page: Page;
  /** Shown above the page, e.g. on the staff preview. */
  banner?: string;
  /** Keeps the page out of search engines (drafts). */
  noindex?: boolean;
}

const { page, banner, noindex } = Astro.props;

// Landing pages often have no summary; their hero's subheading describes them just as well.
const hero = page.blocks.find((block) => block.type === 'hero');
const description = page.summary ?? hero?.subheading;
---

<Layout title={page.title} description={description} cmsId={page.id}>
  {noindex && <meta slot="head" name="robots" content="noindex" />}
  {banner && <p role="status" class="mb-8 bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground">{banner}</p>}
  {
    page.article || page.blogPost ? (
      <ArticleView page={page} article={(page.article ?? page.blogPost)!} />
    ) : (
      <>
        {page.blocks[0]?.type !== 'hero' && (
          <header class="mb-12 border-b border-border pb-8 sm:mb-16">
            <h1 class="max-w-4xl text-4xl leading-tight font-medium text-balance sm:text-6xl">{page.title}</h1>
            {page.summary && <p class="mt-6 max-w-2xl font-serif text-xl leading-relaxed text-pretty text-muted-foreground">{page.summary}</p>}
          </header>
        )}
        <BlockList blocks={page.blocks} />
      </>
    )
  }
</Layout>
