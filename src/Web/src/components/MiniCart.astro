---
import ShoppingCartIcon from '@tabler/icons/outline/shopping-cart.svg';
import { ButtonVariants } from '@/components/starwind/button';

/**
 * Cart icon with the item count and, on hover or focus, the cart's lines. Pages render nothing per visitor, so the
 * cart is fetched in the browser (/api/cart, no-store) and the server-rendered header never contains it; without
 * JavaScript the icon is a plain link to the cart.
 */
interface Props {
  /** On /cart: the link shows as the current page and there is no panel. */
  active: boolean;
}

const { active } = Astro.props;
---

<mini-cart class="contents">
  <div class="group relative">
    <a
      href="/cart"
      aria-current={active ? 'page' : undefined}
      class={ButtonVariants.button({ variant: 'ghost', size: 'icon', class: ['relative', active && 'bg-muted text-foreground hover:bg-muted'] })}
    >
      <ShoppingCartIcon aria-hidden="true" />
      <span class="sr-only" data-label>Cart</span>
      <span
        aria-hidden="true"
        hidden
        data-count
        class="absolute -top-5 -right-5 flex h-21 min-w-21 items-center justify-center rounded-3 bg-primary px-5 text-13 font-semibold text-primary-foreground tabular-nums ring-2 ring-background"
      ></span>
    </a>
    {
      !active && (
        <div
          hidden
          data-panel
          class="invisible absolute top-full right-0 z-20 w-377 pt-8 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 motion-reduce:transition-none"
        >
          <div class="border border-border bg-popover p-13 text-popover-foreground">
            <p hidden data-empty class="py-13 text-center text-13 text-muted-foreground">
              Your cart is empty.
            </p>
            <div hidden data-filled>
              <ul class="divide-y" data-lines></ul>
              <p hidden data-more class="pt-8 text-13 text-muted-foreground"></p>
              <div class="mt-13 flex items-center justify-between border-t pt-13 text-13">
                <span class="text-muted-foreground">Subtotal</span>
                <span class="text-16 font-medium tabular-nums" data-subtotal></span>
              </div>
              <div class="mt-13 grid grid-cols-2 gap-8">
                <a href="/cart" class={ButtonVariants.button({ variant: 'outline', size: 'sm' })}>
                  View cart
                </a>
                <a href="/checkout" class={ButtonVariants.button({ size: 'sm' })}>
                  Checkout
                </a>
              </div>
            </div>
          </div>
          <template data-line>
            <li class="flex gap-13 py-8 first:pt-0">
              <div class="size-55 shrink-0 overflow-hidden bg-muted">
                <img alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
              </div>
              <div class="min-w-0 flex-1 text-13">
                <a class="line-clamp-2 font-semibold decoration-primary decoration-1 underline-offset-4 hover:underline"></a>
                <p class="text-muted-foreground tabular-nums"></p>
              </div>
            </li>
          </template>
        </div>
      )
    }
  </div>
</mini-cart>

<script>
  import type { Cart } from '@/lib/api/client';
  import { formatMoney } from '@/lib/format';
  import { imageAttributes } from '@/lib/image';
  import { loadVisitorJson } from '@/lib/visitor-json';

  const MAX_ITEMS = 4;

  class MiniCart extends HTMLElement {
    connectedCallback() {
      // null for no cart (or when the cart could not be loaded).
      loadVisitorJson<Cart>('/api/cart', (cart) => this.render(cart));
    }

    render(cart: Cart | null) {
      const count = cart?.itemCount ?? 0;
      const badge = this.querySelector<HTMLElement>('[data-count]')!;
      badge.hidden = count === 0;
      badge.textContent = count > 99 ? '99+' : String(count);
      this.querySelector('[data-label]')!.textContent = count > 0 ? `Cart, ${count} ${count === 1 ? 'item' : 'items'}` : 'Cart';

      const panel = this.querySelector<HTMLElement>('[data-panel]');
      if (!panel) return;
      const items = cart?.items ?? [];
      panel.querySelector<HTMLElement>('[data-empty]')!.hidden = items.length > 0;
      panel.querySelector<HTMLElement>('[data-filled]')!.hidden = items.length === 0;
      const line = panel.querySelector<HTMLTemplateElement>('template[data-line]')!.content.firstElementChild!;
      panel.querySelector('[data-lines]')!.replaceChildren(
        ...items.slice(0, MAX_ITEMS).map((item) => {
          const li = line.cloneNode(true) as HTMLElement;
          const img = li.querySelector('img')!;
          if (item.image) {
            const { objectPosition, alt: _, ...attributes } = imageAttributes(item.image, '48px');
            for (const [name, value] of Object.entries(attributes)) if (value !== undefined) img.setAttribute(name, String(value));
            if (objectPosition) img.style.objectPosition = objectPosition;
          } else {
            img.remove();
          }
          const title = li.querySelector('a')!;
          title.href = item.path ?? '/shop';
          title.textContent = item.title;
          li.querySelector('p')!.textContent = `${item.quantity} × ${formatMoney(item.unitPrice)}`;
          return li;
        }),
      );
      const more = panel.querySelector<HTMLElement>('[data-more]')!;
      more.hidden = items.length <= MAX_ITEMS;
      more.textContent = `and ${items.length - MAX_ITEMS} more`;
      if (cart) panel.querySelector('[data-subtotal]')!.textContent = formatMoney(cart.subtotal);
      panel.hidden = false;
    }
  }

  customElements.define('mini-cart', MiniCart);
</script>
