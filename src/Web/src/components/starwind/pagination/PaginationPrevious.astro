---
import type { ComponentProps } from "astro/types";
import ChevronLeft from "@tabler/icons/outline/chevron-left.svg";

import PaginationLink from "./PaginationLink.astro";

type Props = Omit<ComponentProps<typeof PaginationLink>, "size"> & { text?: string };

const { text = "Previous", class: className, ...rest } = Astro.props;
---

<PaginationLink aria-label="Go to previous page" size="default" class:list={["max-sm:p-0! sm:pl-5!", className]} {...rest}>
  <ChevronLeft data-icon="inline-start" />
  <span class="hidden sm:block">{text}</span>
</PaginationLink>
