---
import type { HTMLAttributes } from "astro/types";
import Dots from "@tabler/icons/outline/dots.svg";

import { paginationEllipsis } from "./variants";

type Props = HTMLAttributes<"span">;

const { class: className, ...rest } = Astro.props;
---

<span aria-hidden="true" class={paginationEllipsis({ class: className })} {...rest} data-slot="pagination-ellipsis">
  <Dots />
  <span class="sr-only">More pages</span>
</span>
