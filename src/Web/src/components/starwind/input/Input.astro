---
import InputPrimitive from "@starwind-ui/astro/input";
import type { HTMLAttributes } from "astro/types";
import { input } from "./variants";

interface Props
  extends Omit<HTMLAttributes<"input">, "children" | "defaultValue" | "value"> {
  defaultValue?: string | number | string[];
  value?: string | number | string[];
}

const {
  defaultValue,
  disabled = false,
  value,
  "data-slot": dataSlot = "input",
  class: className,
  ...rest
} = Astro.props;
---

<InputPrimitive.Root
  class={input({ class: className })}
  defaultValue={defaultValue}
  disabled={disabled}
  value={value}
  data-slot={dataSlot}
  {...rest}
/>
