---
import type { Block } from '../../lib/api/client';
import { linkAttrs } from '../../lib/format';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

interface Props {
  block: Extract<Block, { type: 'cta' }>;
}

const { block } = Astro.props;
const primary = block.style === 'primary';
---

<section
  class:list={[
    'flex flex-col gap-6 rounded-3xl px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-10',
    primary ? 'bg-primary text-primary-foreground shadow-sm' : 'border bg-card text-card-foreground',
  ]}
>
  <div class="max-w-2xl">
    <h2 class="text-2xl font-bold tracking-tight text-balance sm:text-3xl">{block.heading}</h2>
    {block.text && <p class:list={['mt-3 text-lg text-pretty', primary ? 'text-primary-foreground/80' : 'text-muted-foreground']}>{block.text}</p>}
  </div>
  {
    block.link && (
      <a
        {...linkAttrs(block.link)}
        class={cn(
          buttonVariants({ variant: primary ? 'secondary' : 'default', size: 'lg' }),
          'h-11 shrink-0 self-start px-5 text-base sm:self-auto',
        )}
      >
        {block.link.title ?? 'Learn more'}
        {block.link.target === '_blank' ? (
          <>
            <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </>
        ) : (
          <span aria-hidden="true">→</span>
        )}
      </a>
    )
  }
</section>
