---
import type { Block } from '../../lib/api/client';
import { linkAttrs } from '../../lib/format';
import { ButtonVariants } from '@/components/starwind/button';
import { cn } from '@/lib/utils';

interface Props {
  block: Extract<Block, { type: 'cta' }>;
}

const { block } = Astro.props;
const primary = block.style === 'primary';
---

<section
  class:list={[
    'flex flex-col gap-8 rounded-lg px-6 py-12 sm:flex-row sm:items-end sm:justify-between sm:px-12',
    primary ? 'bg-muted text-foreground' : 'border border-border bg-card text-card-foreground',
  ]}
>
  <div class="max-w-2xl">
    <h2 class="text-3xl leading-tight font-medium text-balance sm:text-4xl">{block.heading}</h2>
    {block.text && <p class="mt-5 max-w-xl font-serif text-lg leading-relaxed text-pretty text-muted-foreground">{block.text}</p>}
  </div>
  {
    block.link && (
      <a
        {...linkAttrs(block.link)}
        class={cn(
          ButtonVariants.button({ variant: primary ? 'signal' : 'default', size: 'lg' }),
          'shrink-0 self-start sm:self-auto',
        )}
      >
        {block.link.title ?? 'Learn more'}
        {block.link.target === '_blank' && (
          <>
            <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </>
        )}
      </a>
    )
  }
</section>
