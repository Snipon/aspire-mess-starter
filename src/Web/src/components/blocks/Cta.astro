---
import type { Block } from '../../lib/api/client';
import { linkAttrs } from '../../lib/format';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

interface Props {
  block: Extract<Block, { type: 'cta' }>;
}

const { block } = Astro.props;
const primary = block.style === 'primary';
---

<section
  class:list={[
    'chamfer flex flex-col gap-8 px-6 py-12 [--cut:2rem] sm:flex-row sm:items-end sm:justify-between sm:px-12',
    primary ? 'bg-primary text-primary-foreground' : 'border border-border bg-card text-card-foreground',
  ]}
>
  <div class="max-w-2xl">
    <h2 class="font-wide text-3xl leading-none font-extrabold text-balance sm:text-5xl">{block.heading}</h2>
    {block.text && <p class:list={['mt-5 max-w-xl text-lg leading-relaxed text-pretty', primary ? 'text-primary-foreground/80' : 'text-muted-foreground']}>{block.text}</p>}
  </div>
  {
    block.link && (
      <a
        {...linkAttrs(block.link)}
        class={cn(
          buttonVariants({ size: 'lg' }),
          'shrink-0 self-start sm:self-auto',
          primary && 'hover:bg-card hover:text-card-foreground',
        )}
      >
        {block.link.title ?? 'Learn more'}
        {block.link.target === '_blank' ? (
          <>
            <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </>
        ) : null}
      </a>
    )
  }
</section>
