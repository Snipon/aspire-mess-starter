---
import PlayerPauseIcon from '@tabler/icons/outline/player-pause.svg';
import PlayerPlayIcon from '@tabler/icons/outline/player-play.svg';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { ButtonVariants } from '@/components/starwind/button';
import { imageAttributes } from '@/lib/image';
import { cn } from '@/lib/utils';
import type { Block } from '../../lib/api/client';
import { linkAttrs } from '../../lib/format';

interface Props {
  block: Extract<Block, { type: 'hero' }>;
  /** The first block on a page carries the page's h1 and sits directly under the header. */
  first?: boolean;
}

const { block, first = false } = Astro.props;
const Heading = first ? 'h1' : 'h2';
const media = Boolean(block.video || block.image);
// The image is the video's poster, and what shows without the video (reduced motion, unplayable file).
const poster = block.image ? imageAttributes(block.image, '100vw').src : undefined;
---

{/*
  Full-cover opener: the video, else the image, fills the viewport width behind the text (breaking out of the page
  column; body clips the horizontal overflow of 100vw). The text stays aligned with the page column.
*/}
<section
  data-hero
  class={cn(
    'relative mx-[calc(50%-50vw)] flex w-screen items-end overflow-clip',
    first && media && '-mt-34 sm:-mt-55',
    media ? 'min-h-[60vh] bg-ink lg:min-h-[70vh]' : 'border-b',
  )}
>
  {
    block.image && (
      <ResponsiveImage
        image={{ ...block.image, alt: null }}
        loading={first ? 'eager' : 'lazy'}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
    )
  }
  {
    block.video && (
      <video
        muted
        loop
        playsinline
        preload="none"
        data-hero-video
        poster={poster}
        aria-hidden="true"
        tabindex="-1"
        class="absolute inset-0 h-full w-full object-cover motion-reduce:hidden"
      >
        <source src={block.video.url} type={block.video.mimeType} />
      </video>
    )
  }
  {/* Darkest behind the text (bottom-up on phones, where it spans the width; from the left from sm), so white text
      stays readable over bright media. */}
  {
    media && (
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/65 to-black/35 sm:bg-gradient-to-r sm:from-black/80 sm:via-black/60 sm:via-55% sm:to-black/20"
        aria-hidden="true"
      />
    )
  }
  <div class={cn('relative mx-auto w-full max-w-987 px-13 sm:px-21', media ? 'py-55 text-white sm:py-89' : 'pb-55 sm:pb-89')}>
    <div data-hero-copy class="max-w-610">
      <Heading class="text-[clamp(2.125rem,5.5vw,3.4375rem)] leading-[1.08] font-medium text-balance">
        {block.heading}
      </Heading>
      {
        block.subheading && (
          <p
            class={cn(
              'mt-21 max-w-610 font-serif text-21 leading-relaxed text-pretty',
              media ? 'text-white/85' : 'text-muted-foreground',
            )}
          >
            {block.subheading}
          </p>
        )
      }
      {
        block.cta && (
          <a {...linkAttrs(block.cta)} class={cn(ButtonVariants.button({ variant: 'signal', size: 'lg' }), 'mt-34')}>
            {block.cta.title ?? 'Read more'}
          </a>
        )
      }
    </div>
  </div>
  {
    block.video && (
      <button
        type="button"
        hidden
        data-hero-video-toggle
        aria-label="Pause background video"
        aria-pressed="false"
        class={ButtonVariants.button({
          variant: 'outline',
          size: 'icon',
          class: 'absolute right-13 bottom-13 border-white/60 bg-black/40 text-white hover:bg-black/60 hover:text-white motion-reduce:hidden sm:right-21 sm:bottom-21',
        })}
      >
        <span data-icon="pause">
          <PlayerPauseIcon aria-hidden="true" />
        </span>
        <span data-icon="play" hidden>
          <PlayerPlayIcon aria-hidden="true" />
        </span>
      </button>
    )
  }
</section>

<script>
  // Hero videos play only for visitors who have not asked for reduced motion (they see the image instead and never
  // download the video), and the preference is followed live; the pause button stops a video for this page view.
  // Without JavaScript the image shows and there is no button.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const pausedByVisitor = new WeakSet<HTMLVideoElement>();
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-hero-video]')];
  const sync = () =>
    videos.forEach((video) => {
      if (reduce.matches || pausedByVisitor.has(video)) video.pause();
      else video.play().catch(() => {}); // Autoplay can be refused (e.g. power saving): the poster and image remain.
    });

  document.querySelectorAll<HTMLButtonElement>('button[data-hero-video-toggle]').forEach((button) => {
    const video = button.closest('section')?.querySelector<HTMLVideoElement>('video[data-hero-video]');
    if (!video) return;
    const render = () => {
      const paused = pausedByVisitor.has(video);
      button.setAttribute('aria-pressed', String(paused));
      button.querySelector('[data-icon="pause"]')?.toggleAttribute('hidden', paused);
      button.querySelector('[data-icon="play"]')?.toggleAttribute('hidden', !paused);
    };
    button.addEventListener('click', () => {
      if (pausedByVisitor.has(video)) pausedByVisitor.delete(video);
      else pausedByVisitor.add(video);
      render();
      sync();
    });
    render();
    button.hidden = false;
  });

  sync();
  reduce.addEventListener('change', sync);
</script>
