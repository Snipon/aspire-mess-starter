---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { ButtonVariants } from '@/components/starwind/button';
import { cn } from '@/lib/utils';
import type { Block } from '../../lib/api/client';
import { linkAttrs } from '../../lib/format';

interface Props {
  block: Extract<Block, { type: 'hero' }>;
  /** The first block on a page carries the page's h1. */
  first?: boolean;
}

const { block, first = false } = Astro.props;
const Heading = first ? 'h1' : 'h2';
---

{/* Quiet editorial opener: the headline beside the CMS image, if there is one. */}
<section class="grid items-center gap-10 border-b pb-14 sm:pb-20 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
  <div>
    <Heading class="text-[clamp(2.5rem,5.5vw,4.25rem)] leading-[1.08] font-medium text-balance">
      {block.heading}
    </Heading>
    {block.subheading && <p class="mt-6 max-w-xl font-serif text-lg leading-relaxed text-pretty text-muted-foreground sm:text-xl">{block.subheading}</p>}
    {
      block.cta && (
        <a {...linkAttrs(block.cta)} class={cn(ButtonVariants.button({ variant: 'signal', size: 'lg' }), 'mt-8')}>
          {block.cta.title ?? 'Read more'}
        </a>
      )
    }
  </div>
  {
    block.image && (
      <div class="relative hidden aspect-[4/3] overflow-hidden rounded-lg bg-muted lg:block">
        <ResponsiveImage
          image={block.image}
          loading={first ? 'eager' : 'lazy'}
          sizes="(min-width: 1152px) 460px, 40vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    )
  }
</section>
