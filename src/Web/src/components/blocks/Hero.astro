---
import ResponsiveImage from '../ResponsiveImage.astro';
import type { Block } from '../../lib/api/client';
import { linkAttrs } from '../../lib/format';

interface Props {
  block: Extract<Block, { type: 'hero' }>;
  /** The first block on a page carries the page's h1. */
  first?: boolean;
}

const { block, first = false } = Astro.props;
const Heading = first ? 'h1' : 'h2';
---

<section
  class:list={[
    'relative isolate overflow-hidden rounded-3xl px-6 py-16 shadow-sm sm:px-12 sm:py-24',
    block.image ? 'bg-slate-900' : 'bg-linear-to-br from-indigo-600 to-violet-700',
  ]}
>
  {
    block.image && (
      <>
        <ResponsiveImage
          image={block.image}
          loading={first ? 'eager' : 'lazy'}
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-linear-to-r from-slate-950/85 via-slate-950/60 to-slate-950/20" />
      </>
    )
  }
  <div class="max-w-2xl">
    <Heading class="text-4xl font-bold tracking-tight text-balance text-white sm:text-5xl">{block.heading}</Heading>
    {block.subheading && <p class="mt-5 text-lg leading-relaxed text-pretty text-slate-200 sm:text-xl">{block.subheading}</p>}
    {
      block.cta && (
        <a
          {...linkAttrs(block.cta)}
          class="mt-8 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 font-semibold text-slate-900 shadow-sm transition-colors hover:bg-indigo-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          {block.cta.title ?? 'Read more'}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>
