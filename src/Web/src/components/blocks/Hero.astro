---
import ResponsiveImage from '@/components/ResponsiveImage';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import type { Block } from '../../lib/api/client';
import { linkAttrs } from '../../lib/format';

interface Props {
  block: Extract<Block, { type: 'hero' }>;
  /** The first block on a page carries the page's h1. */
  first?: boolean;
}

const { block, first = false } = Astro.props;
const Heading = first ? 'h1' : 'h2';
---

<section
  class:list={[
    'relative isolate overflow-hidden rounded-3xl px-6 py-16 shadow-sm sm:px-12 sm:py-24',
    block.image ? 'bg-neutral-950' : 'bg-linear-to-br from-primary to-violet-700',
  ]}
>
  {
    block.image && (
      <>
        <ResponsiveImage
          image={block.image}
          loading={first ? 'eager' : 'lazy'}
          className="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-linear-to-r from-black/80 via-black/55 to-black/15" />
      </>
    )
  }
  <div class="max-w-2xl">
    <Heading class="text-4xl font-bold tracking-tight text-balance text-white sm:text-5xl">{block.heading}</Heading>
    {block.subheading && <p class="mt-5 text-lg leading-relaxed text-pretty text-white/80 sm:text-xl">{block.subheading}</p>}
    {
      block.cta && (
        <a
          {...linkAttrs(block.cta)}
          class={cn(buttonVariants({ variant: 'secondary', size: 'lg' }), 'mt-8 h-11 px-5 text-base')}
        >
          {block.cta.title ?? 'Read more'}
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</section>
