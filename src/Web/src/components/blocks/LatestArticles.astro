---
import { Swiper, SwiperButtonNext, SwiperButtonPrev, SwiperPagination, SwiperSlide, SwiperWrapper } from 'astro-swiper';
import ArticleCard from '@/components/ArticleCard.astro';
import { ButtonVariants } from '@/components/starwind/button';
import type { Block } from '../../lib/api/client';
import { tagHref } from '../../lib/format';

interface Props {
  block: Extract<Block, { type: 'latestArticles' | 'latestBlogPosts' }>;
}

// One slider for both: articles (optionally of one tag) and blog posts.
const { block } = Astro.props;
const posts = block.type === 'latestBlogPosts';
const items = posts ? block.posts : block.articles;
const heading = block.heading ?? (posts ? 'Latest blog posts' : 'Latest articles');
const tag = posts ? null : block.tag;
---

<section>
  <div data-reveal class="flex items-baseline justify-between gap-13">
    <h2 class="text-34 font-medium">{heading}</h2>
    {
      tag && (
        <a href={tagHref(tag)} class={ButtonVariants.button({ variant: 'link' })}>
          All “{tag}” articles
        </a>
      )
    }
  </div>
  <div class="mt-21">
    {
      items.length > 0 ? (
        <Swiper
          aria-label={heading}
          class="latest-articles pb-55!"
          options={{
            slidesPerView: 1,
            spaceBetween: 24,
            breakpoints: { 640: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
            navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
            pagination: { el: '.swiper-pagination', clickable: true },
            keyboard: { enabled: true, onlyInViewport: true },
            watchSlidesProgress: true,
          }}
        >
          <SwiperWrapper>
            {items.map((article) => (
              <SwiperSlide class="flex! h-auto!">
                <ArticleCard article={article} />
              </SwiperSlide>
            ))}
          </SwiperWrapper>
          <SwiperButtonPrev />
          <SwiperButtonNext />
          <SwiperPagination />
        </Swiper>
      ) : (
        <p class="border border-dashed border-input px-21 py-34 text-center text-muted-foreground">
          No {posts ? 'blog posts' : 'articles'} published yet.
        </p>
      )
    }
  </div>
</section>

<style>
  /* :global, as scoping does not reach into the Swiper component's element. */
  :global(.latest-articles) {
    --swiper-theme-color: var(--primary);
    --swiper-navigation-color: var(--foreground);
    --swiper-navigation-size: 24px;
    --swiper-pagination-bullet-inactive-color: var(--muted-foreground);
    --swiper-pagination-bullet-inactive-opacity: 0.4;
    --swiper-pagination-bottom: 11px;
    /* Bars, not dots: they read as a position gauge. */
    --swiper-pagination-bullet-width: 1.5rem;
    --swiper-pagination-bullet-height: 0.25rem;
    --swiper-pagination-bullet-border-radius: 0;
    --swiper-pagination-bullet-horizontal-gap: 3px;
  }

  /* Arrows in the pagination row (centred on the bullets), not over the card text. */
  :global(.latest-articles .swiper-button-prev),
  :global(.latest-articles .swiper-button-next) {
    top: auto;
    bottom: 0;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: 0;
    border: 1px solid var(--input);
    border-radius: var(--radius-md);
    background: var(--card);
    color: var(--foreground);
  }
  /* Outline icon buttons, like the pager: muted on hover, a ring outline on focus. */
  :global(.latest-articles .swiper-button-prev:hover),
  :global(.latest-articles .swiper-button-next:hover) {
    background: var(--muted);
  }
  :global(.latest-articles .swiper-button-prev:focus-visible),
  :global(.latest-articles .swiper-button-next:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
  :global(.latest-articles .swiper-navigation-icon) {
    width: auto;
    height: 0.875rem;
  }
  :global(.latest-articles .swiper-button-prev) {
    left: 0;
  }
  :global(.latest-articles .swiper-button-next) {
    right: 0;
  }
  /* The slider clips its overflow, so the card's focus outline goes inside the card here. */
  :global(.latest-articles [data-slot='card']:focus-within) {
    outline-offset: -3px;
  }
</style>
