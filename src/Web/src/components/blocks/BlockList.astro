---
import ArticleList from './ArticleList.astro';
import Cta from './Cta.astro';
import Hero from './Hero.astro';
import LatestArticles from './LatestArticles.astro';
import type { Block } from '../../lib/api/client';

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---

<div class="space-y-55 sm:space-y-89">
  {
    blocks.map((block, index) => {
      switch (block.type) {
        case 'hero':
          return <Hero block={block} first={index === 0} />;
        case 'cta':
          return <Cta block={block} />;
        case 'latestArticles':
        case 'latestBlogPosts':
          return <LatestArticles block={block} />;
        case 'articleList':
        case 'blogPostList':
          return <ArticleList block={block} />;
      }
    })
  }
</div>
