---
import { XIcon } from 'lucide-react';
import ArticleGrid from '@/components/ArticleGrid';
import FacetFilters, { type FacetGroup } from '@/components/FacetFilters';
import Pager from '@/components/Pager';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { api, type ArticleSummary, type Block } from '../../lib/api/client';
import { log } from '../../lib/log';

interface Props {
  block: Extract<Block, { type: 'articleList' | 'blogPostList' }>;
}

// Articles get topic and year filters; blog posts (no tags) only the year.
const { block } = Astro.props;
const posts = block.type === 'blogPostList';
const noun = posts ? 'post' : 'article';
const heading = block.heading ?? (posts ? 'All blog posts' : 'All articles');
const params = Astro.url.searchParams;
const tag = (!posts && params.get('tag')) || undefined;
const yearParam = Number.parseInt(params.get('year') ?? '', 10);
const year = Number.isInteger(yearParam) && yearParam >= 1 && yearParam <= 9999 ? yearParam : undefined;
const requestedPage = Number.parseInt(params.get('page') ?? '1', 10);
const page = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

// The search index lists articles newest first when there is no query, with facet counts in the same call.
const search = await api()
  .GET('/api/search', {
    params: { query: { q: '', contentType: posts ? 'blogPost' : 'article', tag, year, page, pageSize: block.pageSize } },
  })
  .catch((cause: unknown) => {
    log.error('Search API unreachable', cause);
    return undefined;
  });
const result = search?.data;
if (search && !result) log.error('Article list failed', undefined, { status: search.response.status, contentType: block.type });

const articles: ArticleSummary[] = (result?.hits ?? []).flatMap((hit) =>
  hit.publishDate
    ? [{ id: hit.id, path: hit.path, title: hit.title, summary: hit.summary, image: hit.image, publishDate: hit.publishDate, tags: hit.tags }]
    : [],
);

type Overrides = { page?: number; tag?: string | null; year?: string | null };
const listHref = (overrides: Overrides) => {
  const next = new URLSearchParams();
  const nextTag = overrides.tag === undefined ? tag : overrides.tag;
  const nextYear = overrides.year === undefined ? year?.toString() : overrides.year;
  if (nextTag) next.set('tag', nextTag);
  if (nextYear) next.set('year', nextYear);
  if (overrides.page && overrides.page > 1) next.set('page', String(overrides.page));
  const query = next.toString();
  return `${Astro.url.pathname}${query ? `?${query}` : ''}#articles`;
};

const groups: FacetGroup[] = result
  ? [
      ...(posts
        ? []
        : [{ label: 'Topic', values: result.facets.tags, selected: tag, href: (value) => listHref({ tag: value }) } satisfies FacetGroup]),
      { label: 'Year', values: result.facets.years, selected: year?.toString(), href: (value) => listHref({ year: value }) },
    ]
  : [];
const totalPages = result ? Math.max(1, Math.ceil(result.total / result.pageSize)) : 0;
---

<section id="articles" class="scroll-mt-24">
  <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{heading}</h2>

  {
    !result ? (
      <Alert variant="destructive" className="mt-6">
        <AlertDescription>{posts ? 'Blog posts' : 'Articles'} are temporarily unavailable. Please try again shortly.</AlertDescription>
      </Alert>
    ) : (
      <div class="mt-6 flex flex-col gap-8 lg:flex-row">
        <FacetFilters groups={groups} />
        <div class="min-w-0 flex-1" aria-live="polite">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
            <p>
              {result.total} {noun}{result.total === 1 ? '' : 's'}
              {tag && ` about “${tag}”`}
              {year && ` from ${year}`}
              {totalPages > 1 && ` · page ${result.page} of ${totalPages}`}
            </p>
            {(tag || year) && (
              <a
                href={listHref({ tag: null, year: null })}
                class={cn(buttonVariants({ variant: 'outline', size: 'xs' }))}
              >
                <XIcon aria-hidden="true" /> Clear filters
              </a>
            )}
          </div>
          {articles.length > 0 ? (
            <div class="mt-4">
              <ArticleGrid articles={articles} />
            </div>
          ) : (
            <p class="mt-4 rounded-xl border border-dashed px-6 py-10 text-center text-muted-foreground">
              No {noun}s match these filters.
            </p>
          )}
          <Pager page={result.page} totalPages={totalPages} href={(n) => listHref({ page: n })} />
        </div>
      </div>
    )
  }
</section>
