---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* A golden spiral over its Fibonacci squares (1, 1, 2, 3, 5, 8 in a 13 × 8 rectangle), like the design scale. */}
<svg aria-hidden="true" class={className} viewBox="-0.5 -0.5 14 9" fill="none" stroke="currentColor" stroke-linecap="round">
<g stroke-opacity=".35" stroke-width="1" vector-effect="non-scaling-stroke"><rect x="3" y="5" width="1" height="1" vector-effect="non-scaling-stroke"/><rect x="4" y="5" width="1" height="1" vector-effect="non-scaling-stroke"/><rect x="3" y="6" width="2" height="2" vector-effect="non-scaling-stroke"/><rect x="0" y="5" width="3" height="3" vector-effect="non-scaling-stroke"/><rect x="0" y="0" width="5" height="5" vector-effect="non-scaling-stroke"/><rect x="5" y="0" width="8" height="8" vector-effect="non-scaling-stroke"/></g>
<path d="M3 6A1 1 0 0 1 4 5A1 1 0 0 1 5 6A2 2 0 0 1 3 8A3 3 0 0 1 0 5A5 5 0 0 1 5 0A8 8 0 0 1 13 8" stroke-width="2" vector-effect="non-scaling-stroke"/>
</svg>