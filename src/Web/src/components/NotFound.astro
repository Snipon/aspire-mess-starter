---
import { buttonVariants } from '@/components/ui/button';
---

<section class="py-6 sm:py-12">
  <p class="text-[clamp(4rem,12vw,8rem)] leading-none font-normal text-muted-foreground tabular-nums">404</p>
  <h1 class="mt-8 border-t border-border pt-4 text-4xl font-medium sm:text-5xl">Page not found</h1>
  <p class="mt-4 max-w-xl text-lg text-muted-foreground">The page you are looking for does not exist or is no longer published.</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/" class={buttonVariants({ size: 'lg' })}>Go home</a>
    <a href="/search" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Search</a>
  </div>
</section>
