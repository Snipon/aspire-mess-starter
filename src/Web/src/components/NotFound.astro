---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
---

<section class="py-6 sm:py-12">
  <p class="font-wide text-[clamp(5rem,20vw,13rem)] leading-[0.85] font-extrabold text-primary tabular-nums">404</p>
  <h1 class="font-wide mt-8 border-t border-ink pt-4 text-4xl font-extrabold sm:text-5xl">Page not found</h1>
  <p class="mt-4 max-w-xl text-lg text-muted-foreground">The page you are looking for does not exist or is no longer published.</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a href="/" class={cn(buttonVariants({ size: 'lg' }))}>Go home</a>
    <a href="/search" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }))}>Search</a>
  </div>
</section>
