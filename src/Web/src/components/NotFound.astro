---
import { ButtonVariants } from '@/components/starwind/button';
---

<section class="py-21 sm:py-55">
  <p class="text-[clamp(3.4375rem,12vw,9rem)] leading-none font-normal text-muted-foreground tabular-nums">404</p>
  <h1 class="mt-34 border-t border-border pt-13 text-34 font-medium sm:text-55">Page not found</h1>
  <p class="mt-13 max-w-610 text-21 text-muted-foreground">The page you are looking for does not exist or is no longer published.</p>
  <div class="mt-34 flex flex-wrap gap-13">
    <a href="/" class={ButtonVariants.button({ size: 'lg' })}>Go home</a>
    <a href="/search" class={ButtonVariants.button({ variant: 'outline', size: 'lg' })}>Search</a>
  </div>
</section>
