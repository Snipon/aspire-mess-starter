---
import { buttonVariants } from '@/components/ui/button';
---

<section class="mx-auto max-w-xl py-16 text-center">
  <p class="text-sm font-semibold tracking-wide text-primary uppercase">404</p>
  <h1 class="mt-2 text-4xl font-bold tracking-tight">Page not found</h1>
  <p class="mt-4 text-muted-foreground">The page you are looking for does not exist or is no longer published.</p>
  <div class="mt-8 flex justify-center gap-3">
    <a href="/" class={buttonVariants({ size: 'lg' })}>Go home</a>
    <a href="/search" class={buttonVariants({ variant: 'outline', size: 'lg' })}>Search</a>
  </div>
</section>
