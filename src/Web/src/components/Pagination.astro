---
interface Props {
  page: number;
  totalPages: number;
  href: (page: number) => string;
}

const { page, totalPages, href } = Astro.props;
const linkClass =
  'rounded-md border border-slate-300 bg-white px-3 py-1.5 font-medium text-slate-700 shadow-sm hover:bg-slate-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600';
---

{
  totalPages > 1 && (
    <nav aria-label="Pagination" class="mt-10 flex items-center justify-between text-sm">
      {page > 1 ? (
        <a href={href(page - 1)} rel="prev" class={linkClass}>
          ← Previous
        </a>
      ) : (
        <span />
      )}
      <span class="text-slate-500">
        Page {page} of {totalPages}
      </span>
      {page < totalPages ? (
        <a href={href(page + 1)} rel="next" class={linkClass}>
          Next →
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
