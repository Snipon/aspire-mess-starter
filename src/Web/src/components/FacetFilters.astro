---
import type { FacetCount } from '../lib/api/client';

export interface FacetGroup {
  label: string;
  values: FacetCount[];
  selected?: string;
  /** Link that selects `value`, or clears the group's filter when `value` is null. */
  href: (value: string | null) => string;
}

interface Props {
  groups: FacetGroup[];
  class?: string;
}

const { groups, class: className } = Astro.props;
const same = (a?: string, b?: string) => a?.toLowerCase() === b?.toLowerCase();
---

<aside class:list={['shrink-0 lg:w-56', className]} aria-label="Filters">
  {
    groups
      .filter((group) => group.values.length > 0)
      .map((group) => (
        <section class="mb-4 lg:mb-6">
          <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">{group.label}</h2>
          <ul class="mt-2 -mx-1 flex gap-1 overflow-x-auto px-1 pb-1 lg:mx-0 lg:block lg:space-y-0.5 lg:px-0">
            {group.values.map((facet) => {
              const selected = same(facet.value, group.selected);
              return (
                <li>
                  <a
                    href={group.href(selected ? null : facet.value)}
                    aria-current={selected ? 'true' : undefined}
                    class:list={[
                      'flex items-center justify-between gap-3 rounded-md px-2.5 py-1.5 text-sm whitespace-nowrap',
                      selected ? 'bg-indigo-600 font-medium text-white' : 'text-slate-700 hover:bg-slate-100',
                    ]}
                  >
                    <span class="truncate">
                      {selected && <span aria-hidden="true">✓ </span>}
                      {facet.value}
                    </span>
                    <span class:list={['tabular-nums', selected ? 'text-indigo-100' : 'text-slate-400']}>{facet.count}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
  }
</aside>
