---
import CheckIcon from '@tabler/icons/outline/check.svg';
import { ButtonVariants } from '@/components/starwind/button';
import type { FacetGroup } from '@/lib/facets';
import { cn } from '@/lib/utils';

interface Props {
  groups: FacetGroup[];
  class?: string;
}

const { groups, class: className } = Astro.props;
// Facet links: a sidebar from lg up, horizontally scrolling chips below.
const same = (a?: string, b?: string) => a?.toLowerCase() === b?.toLowerCase();
---

<aside class={cn('shrink-0 lg:w-56', className)} aria-label="Filters">
  {
    groups
      .filter((group) => group.values.length > 0)
      .map((group) => (
        <section class="mb-4 lg:mb-8 lg:border-t lg:border-border lg:pt-3">
          <h2 class="text-sm font-semibold lg:px-3">{group.label}</h2>
          <ul class="-mx-1 mt-2 flex gap-1 overflow-x-auto px-1 pb-1 lg:mx-0 lg:block lg:space-y-0.5 lg:px-0">
            {group.values.map((facet) => {
              const selected = same(facet.value, group.selected);
              return (
                <li>
                  <a
                    href={group.href(selected ? null : facet.value)}
                    aria-current={selected ? 'true' : undefined}
                    class={ButtonVariants.button({
                      variant: selected ? 'default' : 'ghost',
                      size: 'sm',
                      class: [
                        'h-10 w-full justify-between gap-3 px-3 text-sm lg:h-9 font-medium ',
                        // Chips below lg need an edge; the selected value is filled signal, like the active tab.
                        selected ? 'bg-primary text-primary-foreground' : 'border-border lg:border-transparent',
                      ],
                    })}
                  >
                    <span class="flex items-center gap-1.5 truncate">
                      {selected && <CheckIcon aria-hidden="true" />}
                      {group.format ? group.format(facet.value) : facet.value}
                    </span>
                    <span class={cn('tabular-nums', selected ? 'text-primary-foreground/80' : 'text-muted-foreground')}>
                      {facet.count}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
  }
</aside>
