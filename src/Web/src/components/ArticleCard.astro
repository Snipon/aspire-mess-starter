---
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import TagList from '@/components/TagList.astro';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/starwind/card';
import type { ArticleSummary, BlogPostSummary } from '@/lib/api/client';
import { formatDate } from '@/lib/format';

interface Props {
  /** An article, or a blog post (which has no tags). */
  article: ArticleSummary | BlogPostSummary;
  headingLevel?: 'h2' | 'h3';
}

const { article, headingLevel: Heading = 'h3' } = Astro.props;
---

<Card class="group relative w-full pt-0 transition-colors hover:border-muted-foreground focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring">
  <div class="aspect-[16/10] overflow-hidden bg-muted">
    {
      article.image && (
        <ResponsiveImage
          image={{ ...article.image, alt: null }}
          sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover"
        />
      )
    }
  </div>
  <CardHeader>
    <CardDescription>
      <time datetime={article.publishDate}>{formatDate(article.publishDate)}</time>
    </CardDescription>
    <CardTitle class="text-lg leading-snug font-medium text-balance">
      <Heading>
        <a
          href={article.path}
          class="decoration-primary decoration-1 underline-offset-4 after:absolute after:inset-0 focus-visible:outline-none group-hover:underline"
        >
          {article.title}
        </a>
      </Heading>
    </CardTitle>
  </CardHeader>
  {
    article.summary && (
      <CardContent class="flex-1">
        <p class="line-clamp-3 font-serif text-[0.95rem] leading-relaxed text-muted-foreground">{article.summary}</p>
      </CardContent>
    )
  }
  {
    'tags' in article && article.tags.length > 0 && (
      <CardFooter class="mt-auto border-t-0 bg-transparent">
        <TagList tags={article.tags} />
      </CardFooter>
    )
  }
</Card>
