---
import { BadgeVariants } from '@/components/starwind/badge';
import { tagHref } from '@/lib/format';
import { cn } from '@/lib/utils';

interface Props {
  tags: string[];
  /** Where each tag links to; defaults to the tag's article listing. */
  href?: (tag: string) => string;
  class?: string;
}

const { tags, href = tagHref, class: className } = Astro.props;

// A stable highlight per tag (hash of its name), so a tag has the same colour wherever it appears.
const hues = ['sun', 'sea', 'rose', 'iris'] as const;
const hue = (tag: string) => hues[[...tag.toLowerCase()].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 0) % hues.length];
---

{
  tags.length > 0 && (
    <ul class={cn('flex flex-wrap gap-5', className)} aria-label="Tags">
      {tags.map((tag) => (
        <li>
          {/* z-10: stays clickable above a card's stretched link. */}
          <a href={href(tag)} class={BadgeVariants.badge({ variant: hue(tag), class: 'relative z-10' })}>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
