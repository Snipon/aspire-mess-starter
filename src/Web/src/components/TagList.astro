---
import { tagHref } from '../lib/format';

interface Props {
  tags: string[];
  /** Where each tag links to; defaults to the tag's article listing. */
  href?: (tag: string) => string;
  class?: string;
}

const { tags, href = tagHref, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-1.5', className]} aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a
            href={href(tag)}
            class="relative z-10 inline-block rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-indigo-100 transition-colors ring-inset hover:bg-indigo-100 hover:text-indigo-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
