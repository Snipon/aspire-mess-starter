---
import { ShoppingCartIcon } from 'lucide-react';
import '../styles/global.css';
import SearchInput from '../components/SearchInput.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { getNavigation, type NavItem } from '../lib/api/client';

interface Props {
  title: string;
  description?: string | null;
}

const { title, description } = Astro.props;
const nav = await getNavigation();

// Show each root (normally just Home) followed by its direct children as top-level links.
// The shop is not a CMS page, so it is appended here.
const links: NavItem[] = [
  ...nav.flatMap((root) => [root, ...root.children]),
  { id: 'shop', name: 'Shop', path: '/shop', children: [] },
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (path: string) => {
  const p = path.replace(/\/+$/, '') || '/';
  return p === '/' ? current === '/' : current === p || current.startsWith(`${p}/`);
};
const q = Astro.url.pathname === '/search' ? (Astro.url.searchParams.get('q') ?? '') : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-muted/40 antialiased">
    <header class="sticky top-0 z-10 border-b bg-background/85 backdrop-blur">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <img src="/favicon.svg" alt="" width="28" height="28" />
          <span>Aspire Test</span>
        </a>
        <nav aria-label="Main" class="order-3 w-full sm:order-none sm:w-auto sm:flex-1">
          <ul class="flex flex-wrap gap-1 text-sm">
            {
              links.map((item) => (
                <li>
                  <a
                    href={item.path}
                    aria-current={isActive(item.path) ? 'page' : undefined}
                    class={cn(
                      buttonVariants({ variant: isActive(item.path) ? 'secondary' : 'ghost' }),
                      !isActive(item.path) && 'text-muted-foreground',
                    )}
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <form action="/search" method="get" role="search" class="ml-auto">
          <label for="site-search" class="sr-only">Search</label>
          <SearchInput
            id="site-search"
            value={q}
            placeholder="Search…"
            class="w-40 sm:w-56"
          />
        </form>
        {/* No item count: pages are shared-cached, so nothing per visitor goes in the header. */}
        <a
          href="/cart"
          aria-current={current === '/cart' ? 'page' : undefined}
          class={cn(buttonVariants({ variant: current === '/cart' ? 'secondary' : 'ghost', size: 'icon' }))}
        >
          <ShoppingCartIcon aria-hidden="true" />
          <span class="sr-only">Cart</span>
        </a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6 sm:py-14">
      <slot />
    </main>

    <footer class="border-t bg-background">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-muted-foreground sm:px-6">
        Content from Umbraco, products from Drupal Commerce, search by Meilisearch, served by Astro.
        <a href="/status" class={cn(buttonVariants({ variant: 'link' }), 'h-auto px-1')}>System status</a>
      </div>
    </footer>
  </body>
</html>
