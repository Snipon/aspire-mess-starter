---
import '../styles/global.css';
import AccountMenu from '../components/AccountMenu';
import MiniCart from '../components/MiniCart';
import SearchInput from '../components/SearchInput.astro';
import { cn } from '@/lib/utils';
import { getNavigation, type NavItem } from '../lib/api/client';
import { authEnabled } from '../lib/auth';

interface Props {
  title: string;
  description?: string | null;
}

const { title, description } = Astro.props;
const nav = await getNavigation();

// Show each root (normally just Home) followed by its direct children as top-level links.
// The shop is not a CMS page, so it is appended here.
const links: NavItem[] = [
  ...nav.flatMap((root) => [root, ...root.children]),
  { id: 'shop', name: 'Shop', path: '/shop', children: [] },
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (path: string) => {
  const p = path.replace(/\/+$/, '') || '/';
  return p === '/' ? current === '/' : current === p || current.startsWith(`${p}/`);
};
const q = Astro.url.pathname === '/search' ? (Astro.url.searchParams.get('q') ?? '') : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased">
    <a href="#main" class="sr-only z-50 bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:top-2 focus:left-2">
      Skip to content
    </a>
    {/* .dark flips the tokens inside the header: an ink bar whose inputs, buttons and mini cart follow along. */}
    <header class="dark sticky top-0 z-10 border-b-4 border-primary bg-background text-foreground">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-0 px-4 sm:gap-x-8 sm:px-6">
        <a href="/" class="font-wide py-3 text-xl font-extrabold focus-visible:outline-2 focus-visible:outline-ring">Aspire Test</a>
        <nav aria-label="Main" class="order-3 -mx-1 w-full overflow-x-auto sm:order-none sm:mx-0 sm:w-auto sm:flex-1">
          <ul class="flex text-[0.95rem] font-semibold">
            {
              links.map((item) => (
                <li>
                  <a
                    href={item.path}
                    aria-current={isActive(item.path) ? 'page' : undefined}
                    class={cn(
                      'block px-3 py-4 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-foreground',
                      isActive(item.path)
                        ? 'bg-primary text-primary-foreground'
                        : 'text-muted-foreground hover:text-foreground',
                    )}
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <form action="/search" method="get" role="search" class="ml-auto py-3">
          <label for="site-search" class="sr-only">Search</label>
          <SearchInput id="site-search" value={q} placeholder="Search" class="w-32 sm:w-60" />
        </form>
        {/* Pages are shared-cached: the account state, count and mini cart are fetched per visitor in the browser. */}
        {authEnabled() && <AccountMenu client:load active={current === '/account'} />}
        <MiniCart client:load active={current === '/cart'} />
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 sm:py-16">
      <slot />
    </main>

    <footer class="dark bg-background text-muted-foreground">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:flex-row sm:items-end sm:justify-between sm:px-6">
        <p class="font-wide text-4xl font-extrabold text-foreground sm:text-6xl">Aspire Test</p>
        <p class="max-w-sm text-sm">
          Content from Umbraco, products from Drupal Commerce, search by Meilisearch, served by Astro.{' '}
          <a href="/status" class="font-semibold text-foreground underline decoration-primary decoration-2 underline-offset-4 hover:text-primary">
            System status
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
