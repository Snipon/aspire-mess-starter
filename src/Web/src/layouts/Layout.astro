---
import '../styles/global.css';
import AccountMenu from '../components/AccountMenu.astro';
import Logo from '../components/Logo.astro';
import MiniCart from '../components/MiniCart.astro';
import SearchInput from '../components/SearchInput.astro';
import StaffBar from '../components/StaffBar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { cn } from '@/lib/utils';
import { getNavigation, type Image, type NavItem } from '../lib/api/client';
import { authEnabled } from '../lib/auth';
import { cardImageUrl } from '../lib/image';
import { siteUrl } from '../lib/site';
import { jsonLd } from '../lib/structured-data';
import { staffEnabled } from '../lib/staff';

interface Props {
  title: string;
  description?: string | null;
  /** What the page shows, for the staff bar's "Edit page" / "Edit product" (the same for every visitor). */
  cmsId?: string;
  sku?: string;
  /** Social card image. */
  image?: Image | null;
  /** og:type; "article" for articles and blog posts. */
  type?: 'website' | 'article';
  /** Keeps the page out of search engines: per-visitor pages, search results, errors and drafts. */
  noindex?: boolean;
  /** schema.org objects (lib/structured-data.ts), rendered as one JSON-LD script. */
  structuredData?: object[];
}

const { title, description, cmsId, sku, image, type = 'website', noindex, structuredData } = Astro.props;

// Filters, sort and search terms collapse onto the listing; only the page number stays part of the URL.
const canonical = new URL(Astro.url.pathname, siteUrl(Astro.url));
const pageNumber = Number(Astro.url.searchParams.get('page'));
if (pageNumber > 1) canonical.searchParams.set('page', String(pageNumber));
const siteName = 'Aspire Test';
// "Shop – Page 2 – Aspire Test": unique per page for search results, browser tabs and screen readers (WCAG 2.4.2).
const pageTitle = pageNumber > 1 ? `${title} – Page ${pageNumber}` : title;
const fullTitle = Astro.url.pathname === '/' ? siteName : `${pageTitle} – ${siteName}`;
const cardImage = image && cardImageUrl(image);
// Pages without an image of their own share the site card (public/og-default.png: the mark, name and strapline).
const defaultCard = { url: new URL('/og-default.png', canonical).href, width: 1200, height: 630, alt: `${siteName}: notes on building for the web` };
const nav = await getNavigation();

// Show each root (normally just Home) followed by its direct children as top-level links.
// The shop is not a CMS page, so it is appended here.
const links: NavItem[] = [
  ...nav.flatMap((root) => [root, ...root.children]),
  { id: 'shop', name: 'Shop', path: '/shop', children: [] },
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (path: string) => {
  const p = path.replace(/\/+$/, '') || '/';
  return p === '/' ? current === '/' : current === p || current.startsWith(`${p}/`);
};
const q = Astro.url.pathname === '/search' ? (Astro.url.searchParams.get('q') ?? '') : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Before the first paint, so dark mode never flashes light; the same as applyTheme() in lib/theme.ts. */}
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        theme ??= matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={Astro.url.pathname === '/' ? siteName : pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={cardImage ?? defaultCard.url} />
    {cardImage ? (
      image?.alt && <meta property="og:image:alt" content={image.alt} />
    ) : (
      <>
        <meta property="og:image:width" content={String(defaultCard.width)} />
        <meta property="og:image:height" content={String(defaultCard.height)} />
        <meta property="og:image:alt" content={defaultCard.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData && <script type="application/ld+json" set:html={jsonLd(structuredData)} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-background text-foreground antialiased" data-cms-id={cmsId} data-sku={sku}>
    <a href="#main" class="sr-only z-50 bg-primary px-13 py-8 text-primary-foreground focus:not-sr-only focus:fixed focus:top-8 focus:left-8">
      Skip to content
    </a>
    {staffEnabled() && <StaffBar />}
    {/* Solid at the top; glass once the page scrolls under it (links switch to the full foreground colour so they stay
        readable over whatever is blurred behind); hidden while scrolling down, back on scroll up, and never hidden
        while it holds focus or the pointer (menus). Driven by the script below. */}
    <header
      class="group/header sticky top-0 z-10 border-b bg-background transition-[translate,background-color] duration-233 ease-out motion-reduce:transition-none data-hidden:-translate-y-full data-hidden:focus-within:translate-y-0 data-hidden:hover:translate-y-0 data-scrolled:bg-background/75 data-scrolled:backdrop-blur-xl data-scrolled:backdrop-saturate-150"
    >
      <div class="mx-auto flex max-w-987 flex-wrap items-center gap-x-8 gap-y-0 px-13 sm:gap-x-34 sm:px-21">
        <a href="/" class="flex items-center gap-8 py-13 font-heading text-21 font-medium focus-visible:outline-2 focus-visible:outline-ring">
          <Logo class="h-21 w-34 shrink-0 text-primary" />
          {/* Phones show the mark alone; the name stays the link's accessible name. */}
          <span class="max-sm:sr-only">{siteName}</span>
        </a>
        <nav aria-label="Main" class="order-3 -mx-5 w-full overflow-x-auto sm:order-none sm:mx-0 sm:w-auto sm:flex-1">
          <ul class="flex text-16">
            {
              links.map((item) => (
                <li>
                  <a
                    href={item.path}
                    aria-current={isActive(item.path) ? 'page' : undefined}
                    class={cn(
                      'block px-13 py-13 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-foreground',
                      isActive(item.path)
                        ? 'text-foreground underline decoration-1 underline-offset-8'
                        : 'text-muted-foreground group-data-scrolled/header:text-foreground hover:text-foreground',
                    )}
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <form action="/search" method="get" role="search" aria-label="Site" class="ml-auto py-13">
          <label for="site-search" class="sr-only">Search</label>
          <SearchInput id="site-search" value={q} placeholder="Search" class="w-89 sm:w-233 dark:bg-card" />
        </form>
        {/* Pages render nothing per visitor: the account state, count and mini cart are fetched in the browser. */}
        {authEnabled() && <AccountMenu active={current === '/account'} />}
        <MiniCart active={current === '/cart'} />
        <ThemeToggle />
      </div>
    </header>
    <script>
      const header = document.querySelector<HTMLElement>('body > header')!;
      let last = Math.max(0, scrollY);
      const update = () => {
        const y = Math.max(0, scrollY); // iOS overscroll goes negative
        header.toggleAttribute('data-scrolled', y > 0);
        if (Math.abs(y - last) < 8) return; // ignore jitter
        header.toggleAttribute('data-hidden', y > last && y > header.offsetHeight);
        last = y;
      };
      update();
      addEventListener('scroll', update, { passive: true });
    </script>

    <main id="main" class="mx-auto w-full max-w-987 flex-1 px-13 py-34 sm:px-21 sm:py-55">
      <slot />
    </main>

    <footer class="border-t text-muted-foreground">
      <div class="mx-auto flex max-w-987 flex-col gap-21 px-13 py-55 sm:flex-row sm:items-end sm:justify-between sm:px-21">
        <p class="font-heading text-21 font-medium text-foreground">{siteName}</p>
        <p class="max-w-377 text-13">
          Content from Umbraco, products from Drupal Commerce, search by Meilisearch, served by Astro.{' '}
          <a href="/status" class="text-foreground underline underline-offset-4 hover:text-primary">
            System status
          </a>
          {
            staffEnabled() && (
              <>
                {' '}
                <a href={`/auth/staff/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`} class="underline underline-offset-4 hover:text-foreground">
                  Staff sign-in
                </a>
              </>
            )
          }
        </p>
      </div>
    </footer>
  </body>
</html>
