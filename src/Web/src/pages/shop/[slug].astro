---
import Layout from '../../layouts/Layout.astro';
import NotFound from '../../components/NotFound.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { Badge } from '@/components/starwind/badge';
import { ButtonVariants } from '@/components/starwind/button';
import { cn } from '@/lib/utils';
import { api } from '../../lib/api/client';
import { focusableScrollers, formatDate, formatMoney, formatNumber } from '../../lib/format';
import { cardImageUrl } from '../../lib/image';
import { siteUrl } from '../../lib/site';
import { breadcrumbsJsonLd, productJsonLd } from '../../lib/structured-data';

const slug = Astro.params.slug ?? '';
const { data: product, response } = await api().GET('/api/products/{slug}', { params: { path: { slug } } });
if (!product && response.status !== 404 && response.status !== 400) {
  throw new Error(`Product API returned ${response.status} for ${slug}`);
}

// An outdated slug (renamed product) still finds the product by SKU: send visitors to the canonical URL.
if (product && product.slug !== slug) return Astro.redirect(product.path, 301);
if (!product) Astro.response.status = 404;

const origin = siteUrl(Astro.url);
const structuredData = product && [
  productJsonLd(product, origin, product.image ? cardImageUrl(product.image) : undefined),
  breadcrumbsJsonLd([['Home', '/'], ['Shop', '/shop'], [product.title, product.path]], origin),
];

const maxQuantity = product ? Math.min(product.stock, 10) : 0;
const stats = product
  ? [
      ['Rating', `${product.stats.rating.toFixed(1)} / 5`],
      ['Reviews', formatNumber(product.stats.reviewCount)],
      ['Units sold', formatNumber(product.stats.unitsSold)],
      ['Return rate', `${product.stats.returnRate.toFixed(1)}%`],
      ['In stock', formatNumber(product.stock)],
      ['Warranty', product.warrantyMonths ? (product.warrantyMonths % 12 === 0 ? `${product.warrantyMonths / 12} yr` : `${product.warrantyMonths} mo`) : '–'],
      ['Weight', product.weightGrams ? (product.weightGrams >= 1000 ? `${(product.weightGrams / 1000).toFixed(1)} kg` : `${product.weightGrams} g`) : '–'],
      ['Released', product.releaseDate ? formatDate(product.releaseDate) : '–'],
    ]
  : [];
---

{
  product ? (
    <Layout title={`${product.title} – Shop`} description={product.summary} sku={product.sku} image={product.image} {structuredData}>
      <nav aria-label="Breadcrumb">
        <a href="/shop" class="back-link">
          Shop
        </a>
      </nav>

      <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
        <figure class="self-start overflow-hidden rounded-lg bg-card">
          {product.image && (
            <ResponsiveImage image={product.image} loading="eager" sizes="(min-width: 1024px) 540px, 100vw" class="aspect-[4/3] w-full object-cover" />
          )}
        </figure>

        <div>
          <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted-foreground">
            <a href={`/shop?brand=${encodeURIComponent(product.brand)}`} class="font-semibold text-foreground underline decoration-transparent decoration-1 underline-offset-4 hover:decoration-foreground">{product.brand}</a>
            <a href={`/shop?category=${encodeURIComponent(product.category)}`} class="underline decoration-transparent decoration-1 underline-offset-4 hover:text-foreground hover:decoration-foreground">{product.category}</a>
            <span>SKU {product.sku}</span>
          </p>
          <h1 class="mt-3 text-3xl leading-[1.05] font-medium text-balance sm:text-4xl">{product.title}</h1>
          <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted-foreground">
            <span>
              <span aria-hidden="true">★</span> <span class="font-semibold text-foreground">{product.stats.rating.toFixed(1)}</span><span class="sr-only"> out of 5</span>
            </span>
            <span>{formatNumber(product.stats.reviewCount)} reviews</span>
            <span>{formatNumber(product.stats.unitsSold)} sold</span>
          </p>

          {/* The buy panel reads as the head of a spec sheet: price and action on top, key figures ruled below. */}
          <div class="mt-8 rounded-lg border border-border bg-card">
            <div class="flex flex-wrap items-center justify-between gap-3 px-5 pt-5">
              <p class="text-4xl font-medium tabular-nums sm:text-5xl">{formatMoney(product.price)}</p>
              {product.stock > 0 ? (
                <Badge variant="secondary">{product.stock < 10 ? `Only ${product.stock} left` : 'In stock'}</Badge>
              ) : (
                <Badge variant="destructive">Out of stock</Badge>
              )}
            </div>

            <form method="post" action="/cart" class="flex items-end gap-3 px-5 pt-5 pb-5">
              <input type="hidden" name="action" value="add" />
              <input type="hidden" name="sku" value={product.sku} />
              <label class="grid gap-1.5 text-sm font-semibold">
                Quantity
                <select
                  name="quantity"
                  disabled={maxQuantity === 0}
                  class="h-12 min-w-20 rounded-sm border border-muted-foreground bg-card px-3 text-base tabular-nums hover:border-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:opacity-50"
                >
                  {Array.from({ length: Math.max(maxQuantity, 1) }, (_, i) => (
                    <option value={i + 1}>{i + 1}</option>
                  ))}
                </select>
              </label>
              <button type="submit" disabled={maxQuantity === 0} class={cn(ButtonVariants.button({ size: 'lg' }), 'flex-1 sm:flex-none sm:px-10')}>
                Add to cart
              </button>
            </form>

            <dl class="grid grid-cols-2 gap-px border-t border-border bg-border sm:grid-cols-4">
              {stats.map(([label, value]) => (
                <div class="bg-card px-5 py-3">
                  <dt class="text-xs text-muted-foreground">{label}</dt>
                  <dd class="mt-0.5 font-semibold tabular-nums">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>

      <div class="mt-16 grid gap-12 lg:grid-cols-2">
        <section aria-labelledby="specs">
          <h2 id="specs" class="text-2xl font-medium">Specifications</h2>
          <dl class="mt-4 border-t border-border">
            {product.specs.map((spec) => (
              <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 border-b border-border py-2.5 text-sm">
                <dt class="text-muted-foreground">{spec.label}</dt>
                <dd class="font-semibold tabular-nums">
                  {spec.value}
                  {spec.unit && ` ${spec.unit}`}
                </dd>
              </div>
            ))}
          </dl>
        </section>
        <section aria-labelledby="about">
          <h2 id="about" class="text-2xl font-medium">About this product</h2>
          <div class="prose mt-4 max-w-none border-t border-border pt-4 prose-headings:text-base" set:html={focusableScrollers(product.descriptionHtml)} />
        </section>
      </div>
    </Layout>
  ) : (
    <Layout title="Product not found" noindex>
      <NotFound />
    </Layout>
  )
}
