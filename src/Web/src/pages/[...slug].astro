---
import Layout from '../layouts/Layout.astro';
import ArticleView from '../components/ArticleView.astro';
import BlockList from '../components/blocks/BlockList.astro';
import NotFound from '../components/NotFound.astro';
import { api } from '../lib/api/client';

const path = `/${Astro.params.slug ?? ''}`;
const { data: page, response } = await api().GET('/api/content', {
  params: { query: { path } },
});

if (!page && response.status !== 404 && response.status !== 400) {
  throw new Error(`Content API returned ${response.status} for ${path}`);
}
if (!page) Astro.response.status = 404;

// Landing pages often have no summary; their hero's subheading describes them just as well.
const hero = page?.blocks.find((block) => block.type === 'hero');
const description = page?.summary ?? hero?.subheading;
---

{
  page ? (
    <Layout title={page.title} description={description} cmsId={page.id}>
      {page.article || page.blogPost ? (
        <ArticleView page={page} article={(page.article ?? page.blogPost)!} />
      ) : (
        <>
          {page.blocks[0]?.type !== 'hero' && (
            <header class="mb-12 border-b border-ink pb-8 sm:mb-16">
              <h1 class="font-wide max-w-4xl text-5xl leading-[0.95] font-extrabold text-balance sm:text-7xl">{page.title}</h1>
              {page.summary && <p class="mt-6 max-w-2xl text-xl leading-relaxed text-pretty text-muted-foreground">{page.summary}</p>}
            </header>
          )}
          <BlockList blocks={page.blocks} />
        </>
      )}
    </Layout>
  ) : (
    <Layout title="Page not found">
      <NotFound />
    </Layout>
  )
}
