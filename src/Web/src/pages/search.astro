---
import Layout from '../layouts/Layout.astro';
import FacetFilters, { type FacetGroup } from '../components/FacetFilters.astro';
import Pagination from '../components/Pagination.astro';
import SearchInput from '../components/SearchInput.astro';
import TagList from '../components/TagList.astro';
import { api, type SearchResult } from '../lib/api/client';
import { formatDate, tagHref } from '../lib/format';
import { log } from '../lib/log';

const PAGE_SIZE = 10;
const params = Astro.url.searchParams;
const q = (params.get('q') ?? '').trim();
const contentType = params.get('contentType') || undefined;
const tag = params.get('tag') || undefined;
const requestedPage = Number.parseInt(params.get('page') ?? '1', 10);
const pageNumber = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

let result: SearchResult | undefined;
let error: string | undefined;

// Without a query this still runs: it returns no hits, only the facets, which list the topics to browse.
const search = await api()
  .GET('/api/search', { params: { query: { q, page: pageNumber, pageSize: PAGE_SIZE, contentType, tag } } })
  .catch((cause: unknown) => {
    log.error('Search API unreachable', cause);
    return undefined;
  });
if (search?.data) {
  result = search.data;
} else if (search?.response.status === 400) {
  Astro.response.status = 400;
  error = search.error?.detail ?? search.error?.title ?? 'Invalid search request.';
} else {
  // Search backend down: keep the page usable instead of the 500 page.
  if (search) log.error('Search API failed', undefined, { status: search.response.status });
  if (q) {
    Astro.response.status = 503;
    error = 'Search is temporarily unavailable. Please try again shortly.';
  }
}

type Overrides = { page?: number; tag?: string | null; contentType?: string | null };
const searchHref = (overrides: Overrides) => {
  const next = new URLSearchParams({ q });
  const nextTag = overrides.tag === undefined ? tag : overrides.tag;
  const nextType = overrides.contentType === undefined ? contentType : overrides.contentType;
  if (nextTag) next.set('tag', nextTag);
  if (nextType) next.set('contentType', nextType);
  if (overrides.page && overrides.page > 1) next.set('page', String(overrides.page));
  return `/search?${next}`;
};

const facetGroups: FacetGroup[] = result
  ? [
      {
        label: 'Type',
        values: result.facets.contentTypes,
        selected: contentType,
        href: (value) => searchHref({ contentType: value }),
      },
      { label: 'Topic', values: result.facets.tags, selected: tag, href: (value) => searchHref({ tag: value }) },
    ]
  : [];
const topics = result?.facets.tags.map((t) => t.value) ?? [];
const filtered = Boolean(tag || contentType);

const totalPages = result ? Math.max(1, Math.ceil(result.total / result.pageSize)) : 0;
---

<Layout title={q ? `Search: ${q}` : 'Search'}>
  <div class="max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight">Search</h1>

    <form action="/search" method="get" role="search" class="mt-6 flex flex-col gap-2 sm:flex-row">
      <label for="q" class="sr-only">Search terms</label>
      <div class="min-w-0 flex-1">
        <SearchInput
          id="q"
          value={q}
          autofocus={!q}
          placeholder="What are you looking for?"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
        />
      </div>
      {tag && <input type="hidden" name="tag" value={tag} />}
      {contentType && <input type="hidden" name="contentType" value={contentType} />}
      <button
        type="submit"
        class="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white shadow-sm hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      >
        Search
      </button>
    </form>

    {error && <p class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-red-700" role="alert">{error}</p>}

    {
      !q && topics.length > 0 && (
        <section class="mt-10">
          <h2 class="text-sm font-semibold tracking-wide text-slate-500 uppercase">Browse by topic</h2>
          <TagList tags={topics} class="mt-3" />
        </section>
      )
    }

    {
      tag && !q && (
        <p class="mt-8 text-slate-600">
          Enter a search term, or <a href={tagHref(tag)} class="font-medium text-indigo-600 hover:text-indigo-500">browse all “{tag}” articles</a>.
        </p>
      )
    }
  </div>

  {
    q && result && (
      <div class="mt-8 flex flex-col gap-8 lg:flex-row-reverse">
        <FacetFilters groups={facetGroups} />

        <section class="min-w-0 flex-1" aria-live="polite">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-slate-500">
            <p>
              {result.total === 0
                ? `No results for “${result.query}”`
                : `${result.total} result${result.total === 1 ? '' : 's'} for “${result.query}”`}
              {contentType && ` in ${contentType}s`}
              {tag && ` about “${tag}”`}.
            </p>
            {filtered && (
              <a
                href={searchHref({ tag: null, contentType: null })}
                class="inline-flex items-center gap-1 rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-medium text-slate-700 hover:bg-slate-300"
              >
                <span aria-hidden="true">×</span> Clear filters
              </a>
            )}
          </div>

          <ol class="mt-4 space-y-3">
            {result.hits.map((hit) => (
              <li class="relative flex gap-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition focus-within:ring-2 focus-within:ring-indigo-600 hover:border-indigo-300 hover:shadow">
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline justify-between gap-4">
                    <h2 class="text-lg font-semibold text-slate-900">
                      <a href={hit.path} class="after:absolute after:inset-0 focus-visible:outline-none">
                        {hit.title}
                      </a>
                    </h2>
                    <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600">
                      {hit.contentType}
                    </span>
                  </div>
                  <p class="mt-0.5 text-sm text-slate-500">
                    <span class="text-indigo-600">{hit.path}</span>
                    {hit.publishDate && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <time datetime={hit.publishDate}>{formatDate(hit.publishDate)}</time>
                      </>
                    )}
                  </p>
                  {hit.highlight ? (
                    <p class="mt-2 text-slate-600" set:html={hit.highlight} />
                  ) : (
                    hit.summary && <p class="mt-2 text-slate-600">{hit.summary}</p>
                  )}
                  <TagList tags={hit.tags} href={(t) => searchHref({ tag: t })} class="mt-3" />
                </div>
                {hit.imageUrl && (
                  <img
                    src={hit.imageUrl}
                    alt=""
                    width="96"
                    height="96"
                    loading="lazy"
                    decoding="async"
                    class="hidden size-24 shrink-0 rounded-lg bg-slate-100 object-cover sm:block"
                  />
                )}
              </li>
            ))}
          </ol>

          <Pagination page={result.page} totalPages={totalPages} href={(n) => searchHref({ page: n })} />
        </section>
      </div>
    )
  }
</Layout>
