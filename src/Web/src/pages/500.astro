---
import Layout from '../layouts/Layout.astro';
import { log } from '../lib/log';

interface Props {
  error: unknown;
}

log.error('Unhandled error while rendering a page', Astro.props.error);
---

<Layout title="Something went wrong">
  <section class="py-6 sm:py-12">
    <p class="font-wide text-[clamp(5rem,20vw,13rem)] leading-[0.85] font-extrabold text-primary tabular-nums">500</p>
    <h1 class="font-wide mt-8 border-t border-ink pt-4 text-4xl font-extrabold sm:text-5xl">Something went wrong</h1>
    <p class="mt-4 max-w-xl text-lg text-muted-foreground">The content service is unavailable right now. Please try again in a moment.</p>
  </section>
</Layout>
