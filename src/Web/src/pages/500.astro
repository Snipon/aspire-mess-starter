---
import Layout from '../layouts/Layout.astro';
import { log } from '../lib/log';

interface Props {
  error: unknown;
}

log.error('Unhandled error while rendering a page', Astro.props.error);
---

<Layout title="Something went wrong" noindex>
  <section class="py-6 sm:py-12">
    <p class="text-[clamp(4rem,12vw,8rem)] leading-none font-normal text-muted-foreground tabular-nums">500</p>
    <h1 class="mt-8 border-t border-border pt-4 text-4xl font-medium sm:text-5xl">Something went wrong</h1>
    <p class="mt-4 max-w-xl text-lg text-muted-foreground">The content service is unavailable right now. Please try again in a moment.</p>
  </section>
</Layout>
