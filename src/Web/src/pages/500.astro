---
import Layout from '../layouts/Layout.astro';
import { log } from '../lib/log';

interface Props {
  error: unknown;
}

log.error('Unhandled error while rendering a page', Astro.props.error);
---

<Layout title="Something went wrong" noindex>
  <section class="py-21 sm:py-55">
    <p class="text-[clamp(3.4375rem,12vw,9rem)] leading-none font-normal text-muted-foreground tabular-nums">500</p>
    <h1 class="mt-34 border-t border-border pt-13 text-34 font-medium sm:text-55">Something went wrong</h1>
    <p class="mt-13 max-w-610 text-21 text-muted-foreground">The content service is unavailable right now. Please try again in a moment.</p>
  </section>
</Layout>
