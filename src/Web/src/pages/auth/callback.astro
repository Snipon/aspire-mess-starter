---
import Layout from '../../layouts/Layout.astro';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { authEnabled, completeSignIn } from '../../lib/auth';
import { log } from '../../lib/log';

// The identity provider redirects here with the authorization code. Per visitor: never cached.
Astro.response.headers.set('Cache-Control', 'no-store');
if (!authEnabled()) return new Response(null, { status: 404, headers: { 'Cache-Control': 'no-store' } });

let returnTo: string | undefined;
try {
  returnTo = await completeSignIn(Astro.cookies, Astro.url);
} catch (error) {
  // Cancelled at the provider, an expired or replayed callback, or a token that failed validation.
  log.warn('Sign-in failed', error);
  Astro.response.status = 400;
}
if (returnTo) return Astro.redirect(returnTo, 303);
---

<Layout title="Sign-in failed">
  <section class="mx-auto max-w-xl text-center">
    <h1 class="text-3xl font-bold tracking-tight">Sign-in did not complete</h1>
    <p class="mt-3 text-muted-foreground">It was cancelled or took too long. Your cart is still there.</p>
    <a href="/auth/login" class={cn(buttonVariants(), 'mt-8')}>Try again</a>
  </section>
</Layout>
