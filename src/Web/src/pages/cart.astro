---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '@/components/ResponsiveImage';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { api } from '../lib/api/client';
import { cartErrors, cartHeaders, ensureCart, loadCart } from '../lib/cart';
import { formatMoney } from '../lib/format';

// Per visitor: never stored by the reverse proxy or the browser.
Astro.response.headers.set('Cache-Control', 'no-store');

// Form posts (add from a product page, change quantity, remove), then redirect back here (POST/redirect/GET).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  const quantity = Number.parseInt(String(form.get('quantity') ?? ''), 10);
  let error: string | undefined;
  if (action === 'add') {
    const ref = await ensureCart(Astro.cookies, Astro.url);
    const { error: problem } = await api().POST('/api/carts/{cartId}/items', {
      params: cartHeaders(ref),
      body: { sku: String(form.get('sku') ?? ''), quantity: Number.isFinite(quantity) ? quantity : 1 },
    });
    error = problem ? ((problem as { code?: string }).code ?? 'invalid_request') : undefined;
  } else if (action === 'update' || action === 'remove') {
    const loaded = await loadCart(Astro.cookies);
    const itemId = String(form.get('item') ?? '');
    if (loaded) {
      const params = { ...cartHeaders(loaded.ref), path: { cartId: loaded.ref.id, itemId } };
      const { error: problem } =
        action === 'remove'
          ? await api().DELETE('/api/carts/{cartId}/items/{itemId}', { params })
          : await api().PATCH('/api/carts/{cartId}/items/{itemId}', { params, body: { quantity: Number.isFinite(quantity) ? quantity : 0 } });
      error = problem ? ((problem as { code?: string }).code ?? 'invalid_request') : undefined;
    }
  }

  return Astro.redirect(error ? `/cart?error=${encodeURIComponent(error)}` : '/cart', 303);
}

const loaded = await loadCart(Astro.cookies);
const cart = loaded?.cart;
const errorCode = Astro.url.searchParams.get('error');
const message = errorCode ? (cartErrors[errorCode] ?? 'That did not work. Please try again.') : undefined;
---

<Layout title="Cart">
  <h1 class="text-4xl font-bold tracking-tight">Cart</h1>

  {
    message && (
      <Alert variant="destructive" className="mt-6">
        <AlertDescription>{message}</AlertDescription>
      </Alert>
    )
  }

  {
    !cart || cart.items.length === 0 ? (
      <div class="mt-8 rounded-xl border border-dashed px-6 py-12 text-center">
        <p class="text-muted-foreground">Your cart is empty.</p>
        <a href="/shop" class={cn(buttonVariants(), 'mt-4')}>
          Browse the shop
        </a>
      </div>
    ) : (
      <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_18rem]">
        <ul class="h-fit divide-y rounded-xl border bg-background">
          {cart.items.map((item) => (
            <li class="flex gap-4 p-4">
              <div class="size-20 shrink-0 overflow-hidden rounded-md bg-muted">
                {item.image && <ResponsiveImage image={{ ...item.image, alt: null }} sizes="80px" className="h-full w-full object-cover" />}
              </div>
              <div class="min-w-0 flex-1">
                <a href={item.path ?? '/shop'} class="font-medium hover:underline">
                  {item.title}
                </a>
                <p class="text-sm text-muted-foreground">
                  {formatMoney(item.unitPrice)} each · SKU {item.sku}
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <form method="post" class="flex items-center gap-2">
                    <input type="hidden" name="action" value="update" />
                    <input type="hidden" name="item" value={item.id} />
                    <label class="sr-only" for={`qty-${item.id}`}>
                      Quantity of {item.title}
                    </label>
                    <select
                      id={`qty-${item.id}`}
                      name="quantity"
                      class="h-8 rounded-md border border-input bg-background px-2 text-sm"
                    >
                      {Array.from({ length: Math.max(Math.min(item.stock, 10), item.quantity) }, (_, i) => (
                        <option value={i + 1} selected={i + 1 === item.quantity}>
                          {i + 1}
                        </option>
                      ))}
                    </select>
                    <button type="submit" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }))}>
                      Update
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="item" value={item.id} />
                    <button type="submit" class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'text-muted-foreground')}>
                      Remove
                    </button>
                  </form>
                </div>
              </div>
              <p class="font-semibold tabular-nums">{formatMoney(item.total)}</p>
            </li>
          ))}
        </ul>
        <aside class="h-fit rounded-xl border bg-background p-5">
          <h2 class="font-semibold">Summary</h2>
          <dl class="mt-3 space-y-1 text-sm">
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Items</dt>
              <dd class="tabular-nums">{cart.itemCount}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Subtotal</dt>
              <dd class="tabular-nums">{formatMoney(cart.subtotal)}</dd>
            </div>
            <div class="flex justify-between border-t pt-2 text-base font-semibold">
              <dt>Total</dt>
              <dd class="tabular-nums">{formatMoney(cart.total)}</dd>
            </div>
          </dl>
          <a href="/checkout" class={cn(buttonVariants({ size: 'lg' }), 'mt-5 w-full')}>
            Checkout
          </a>
        </aside>
      </div>
    )
  }
</Layout>
