---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { Alert, AlertDescription } from '@/components/starwind/alert';
import { ButtonVariants } from '@/components/starwind/button';
import { cn } from '@/lib/utils';
import { api } from '../lib/api/client';
import { cartErrors, cartHeaders, ensureCart, loadCart } from '../lib/cart';
import { formatMoney } from '../lib/format';

// Per visitor: never stored by the browser or any cache in between.
Astro.response.headers.set('Cache-Control', 'no-store');

// Form posts (add from a product page, change quantity, remove), then redirect back here (POST/redirect/GET).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  const quantity = Number.parseInt(String(form.get('quantity') ?? ''), 10);
  let error: string | undefined;
  if (action === 'add') {
    const ref = await ensureCart(Astro.cookies, Astro.url);
    const { error: problem } = await api().POST('/api/carts/{cartId}/items', {
      params: cartHeaders(ref),
      body: { sku: String(form.get('sku') ?? ''), quantity: Number.isFinite(quantity) ? quantity : 1 },
    });
    error = problem ? ((problem as { code?: string }).code ?? 'invalid_request') : undefined;
  } else if (action === 'update' || action === 'remove') {
    const loaded = await loadCart(Astro.cookies);
    const itemId = String(form.get('item') ?? '');
    if (loaded) {
      const params = { ...cartHeaders(loaded.ref), path: { cartId: loaded.ref.id, itemId } };
      const { error: problem } =
        action === 'remove'
          ? await api().DELETE('/api/carts/{cartId}/items/{itemId}', { params })
          : await api().PATCH('/api/carts/{cartId}/items/{itemId}', { params, body: { quantity: Number.isFinite(quantity) ? quantity : 0 } });
      error = problem ? ((problem as { code?: string }).code ?? 'invalid_request') : undefined;
    }
  }

  return Astro.redirect(error ? `/cart?error=${encodeURIComponent(error)}` : '/cart', 303);
}

const loaded = await loadCart(Astro.cookies);
const cart = loaded?.cart;
const errorCode = Astro.url.searchParams.get('error');
const message = errorCode ? (cartErrors[errorCode] ?? 'That did not work. Please try again.') : undefined;
---

<Layout title="Cart" noindex>
  <h1 class="page-title">Cart</h1>

  {
    message && (
      <Alert variant="destructive" class="mt-21">
        <AlertDescription>{message}</AlertDescription>
      </Alert>
    )
  }

  {
    !cart || cart.items.length === 0 ? (
      <div class="mt-34 border border-dashed border-input px-21 py-55 text-center">
        <p class="text-21 text-muted-foreground">Your cart is empty.</p>
        <a href="/shop" class={cn(ButtonVariants.button({ size: 'lg' }), 'mt-21')}>
          Browse the shop
        </a>
      </div>
    ) : (
      <div class="mt-34 grid grid-cols-1 gap-34 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <ul class="h-fit divide-y border border-border bg-card">
          {cart.items.map((item) => (
            <li class="flex gap-13 p-13 sm:p-21">
              <div class="size-55 shrink-0 overflow-hidden bg-muted sm:size-89">
                {item.image && <ResponsiveImage image={{ ...item.image, alt: null }} sizes="80px" class="h-full w-full object-cover" />}
              </div>
              <div class="min-w-0 flex-1">
                <a href={item.path ?? '/shop'} class="font-semibold decoration-primary decoration-1 underline-offset-4 hover:underline">
                  {item.title}
                </a>
                <p class="mt-2 flex flex-wrap gap-x-13 text-13 text-muted-foreground">
                  <span class="tabular-nums">{formatMoney(item.unitPrice)} each</span>
                  <span>SKU {item.sku}</span>
                </p>
                <div class="mt-13 flex flex-wrap items-center gap-8">
                  <form method="post" class="flex items-center gap-8">
                    <input type="hidden" name="action" value="update" />
                    <input type="hidden" name="item" value={item.id} />
                    <label class="sr-only" for={`qty-${item.id}`}>
                      Quantity of {item.title}
                    </label>
                    <select
                      id={`qty-${item.id}`}
                      name="quantity"
                      class="h-34 rounded-3 border border-muted-foreground bg-card px-8 text-13 tabular-nums hover:border-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                    >
                      {Array.from({ length: Math.max(Math.min(item.stock, 10), item.quantity) }, (_, i) => (
                        <option value={i + 1} selected={i + 1 === item.quantity}>
                          {i + 1}
                        </option>
                      ))}
                    </select>
                    <button type="submit" class={cn(ButtonVariants.button({ variant: 'outline', size: 'sm' }), 'h-34')}>
                      Update
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="item" value={item.id} />
                    <button type="submit" class={cn(ButtonVariants.button({ variant: 'ghost', size: 'sm' }), 'h-34 text-muted-foreground')}>
                      Remove
                    </button>
                  </form>
                </div>
              </div>
              <p class="text-16 font-medium tabular-nums sm:text-21">{formatMoney(item.total)}</p>
            </li>
          ))}
        </ul>
        {/* Order summary: the page's primary panel. */}
        <aside class="h-fit rounded-5 border bg-card p-21">
          <h2 class="font-sans text-21 font-medium">Summary</h2>
          <dl class="mt-13 space-y-5 text-13">
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Items</dt>
              <dd class="tabular-nums">{cart.itemCount}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Subtotal</dt>
              <dd class="tabular-nums">{formatMoney(cart.subtotal)}</dd>
            </div>
            <div class="mt-13 flex items-baseline justify-between border-t pt-13">
              <dt class="font-semibold">Total</dt>
              <dd class="text-21 font-medium tabular-nums">{formatMoney(cart.total)}</dd>
            </div>
          </dl>
          <a href="/checkout" class={cn(ButtonVariants.button({ variant: 'signal', size: 'lg' }), 'mt-21 w-full')}>
            Checkout
          </a>
        </aside>
      </div>
    )
  }
</Layout>
