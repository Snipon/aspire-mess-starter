---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '@/components/ResponsiveImage';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { api } from '../lib/api/client';
import { cartErrors, cartHeaders, ensureCart, loadCart } from '../lib/cart';
import { formatMoney } from '../lib/format';

// Per visitor: never stored by the reverse proxy or the browser.
Astro.response.headers.set('Cache-Control', 'no-store');

// Form posts (add from a product page, change quantity, remove), then redirect back here (POST/redirect/GET).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action');
  const quantity = Number.parseInt(String(form.get('quantity') ?? ''), 10);
  let error: string | undefined;
  if (action === 'add') {
    const ref = await ensureCart(Astro.cookies, Astro.url);
    const { error: problem } = await api().POST('/api/carts/{cartId}/items', {
      params: cartHeaders(ref),
      body: { sku: String(form.get('sku') ?? ''), quantity: Number.isFinite(quantity) ? quantity : 1 },
    });
    error = problem ? ((problem as { code?: string }).code ?? 'invalid_request') : undefined;
  } else if (action === 'update' || action === 'remove') {
    const loaded = await loadCart(Astro.cookies);
    const itemId = String(form.get('item') ?? '');
    if (loaded) {
      const params = { ...cartHeaders(loaded.ref), path: { cartId: loaded.ref.id, itemId } };
      const { error: problem } =
        action === 'remove'
          ? await api().DELETE('/api/carts/{cartId}/items/{itemId}', { params })
          : await api().PATCH('/api/carts/{cartId}/items/{itemId}', { params, body: { quantity: Number.isFinite(quantity) ? quantity : 0 } });
      error = problem ? ((problem as { code?: string }).code ?? 'invalid_request') : undefined;
    }
  }

  return Astro.redirect(error ? `/cart?error=${encodeURIComponent(error)}` : '/cart', 303);
}

const loaded = await loadCart(Astro.cookies);
const cart = loaded?.cart;
const errorCode = Astro.url.searchParams.get('error');
const message = errorCode ? (cartErrors[errorCode] ?? 'That did not work. Please try again.') : undefined;
---

<Layout title="Cart">
  <h1 class="font-wide page-title">Cart</h1>

  {
    message && (
      <Alert variant="destructive" className="mt-6">
        <AlertDescription>{message}</AlertDescription>
      </Alert>
    )
  }

  {
    !cart || cart.items.length === 0 ? (
      <div class="mt-10 border border-dashed border-input px-6 py-14 text-center">
        <p class="text-lg text-muted-foreground">Your cart is empty.</p>
        <a href="/shop" class={cn(buttonVariants({ size: 'lg' }), 'mt-6')}>
          Browse the shop
        </a>
      </div>
    ) : (
      <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <ul class="h-fit divide-y border border-border bg-card">
          {cart.items.map((item) => (
            <li class="flex gap-3 p-4 sm:gap-4 sm:p-5">
              <div class="size-16 shrink-0 overflow-hidden bg-muted sm:size-20">
                {item.image && <ResponsiveImage image={{ ...item.image, alt: null }} sizes="80px" className="h-full w-full object-cover" />}
              </div>
              <div class="min-w-0 flex-1">
                <a href={item.path ?? '/shop'} class="font-bold decoration-primary decoration-2 underline-offset-4 hover:underline">
                  {item.title}
                </a>
                <p class="font-narrow mt-0.5 flex flex-wrap gap-x-4 text-sm text-muted-foreground">
                  <span class="tabular-nums">{formatMoney(item.unitPrice)} each</span>
                  <span>SKU {item.sku}</span>
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <form method="post" class="flex items-center gap-2">
                    <input type="hidden" name="action" value="update" />
                    <input type="hidden" name="item" value={item.id} />
                    <label class="sr-only" for={`qty-${item.id}`}>
                      Quantity of {item.title}
                    </label>
                    <select
                      id={`qty-${item.id}`}
                      name="quantity"
                      class="h-10 rounded-sm border border-muted-foreground bg-card sm:h-8 px-2 text-sm tabular-nums hover:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                    >
                      {Array.from({ length: Math.max(Math.min(item.stock, 10), item.quantity) }, (_, i) => (
                        <option value={i + 1} selected={i + 1 === item.quantity}>
                          {i + 1}
                        </option>
                      ))}
                    </select>
                    <button type="submit" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'h-10 sm:h-8')}>
                      Update
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="item" value={item.id} />
                    <button type="submit" class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'h-10 text-muted-foreground sm:h-8')}>
                      Remove
                    </button>
                  </form>
                </div>
              </div>
              <p class="font-wide text-base font-extrabold tabular-nums sm:text-lg">{formatMoney(item.total)}</p>
            </li>
          ))}
        </ul>
        {/* Ink panel (.dark scope) with the machined corner: the page's primary panel. */}
        <aside class="dark chamfer h-fit bg-background p-6 text-foreground [--cut:1.5rem]">
          <h2 class="font-wide text-xl font-extrabold">Summary</h2>
          <dl class="mt-4 space-y-1.5 text-sm">
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Items</dt>
              <dd class="font-narrow tabular-nums">{cart.itemCount}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Subtotal</dt>
              <dd class="font-narrow tabular-nums">{formatMoney(cart.subtotal)}</dd>
            </div>
            <div class="mt-3 flex items-baseline justify-between border-t pt-3">
              <dt class="font-semibold">Total</dt>
              <dd class="font-wide text-2xl font-extrabold tabular-nums">{formatMoney(cart.total)}</dd>
            </div>
          </dl>
          <a href="/checkout" class={cn(buttonVariants({ variant: 'signal', size: 'lg' }), 'mt-6 w-full')}>
            Checkout
          </a>
        </aside>
      </div>
    )
  }
</Layout>
