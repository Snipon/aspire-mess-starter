{
  "openapi": "3.1.1",
  "info": {
    "title": "Content API",
    "description": "Typed content and search API for the web front end. CMS and search engine are swappable adapters.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/webhooks/content": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Content changed webhook",
        "description": "Called by the CMS on publish/unpublish/delete/move with `{ \"id\": \"...\" }` (or an array of those, as sent for move and moved-to-recycle-bin). Each item is re-read from the content source and upserted if published, otherwise removed; when its path changed or it disappeared, the documents indexed below its old path are re-read as well. Requires the `X-Webhook-Secret` header.",
        "operationId": "ContentWebhook",
        "parameters": [
          {
            "name": "X-Webhook-Secret",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentWebhookPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContentSyncResult"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Get the status of the API's dependencies",
        "description": "Overall and per-component status (`healthy`, `degraded` or `unhealthy`) for the status page. Always 200: the status is in the body. The dependencies are checked at most every 10 seconds; in between the last report is returned. Probes should use `/health`.",
        "operationId": "GetStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/content": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Get a page by its URL path",
        "description": "Returns the published page at `path` (e.g. `/articles`; `/` is the home page).",
        "operationId": "GetContentByPath",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/content/{id}": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Get a page by id",
        "operationId": "GetContentById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/navigation": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Get the navigation tree",
        "description": "Root pages (normally the home page) with their descendants as children, in CMS sort order. Articles are not included; list them with `/api/articles`.",
        "operationId": "GetNavigation",
        "parameters": [
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NavItem"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/articles": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "List published articles, newest first",
        "description": "Ordered by publish date, descending. `tag` keeps only articles with that tag (case-insensitive).",
        "operationId": "GetArticles",
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedOfArticleSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/tags": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "List article tags with counts",
        "description": "Every tag used by a published article and how many articles carry it, most used first.",
        "operationId": "GetTags",
        "parameters": [
          {
            "name": "culture",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagCount"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Full-text search",
        "description": "Searches pages and articles. `contentType`, `tag` and `year` (publish year) narrow the results; `facets` counts the values of each, ignoring that facet's own filter. An empty `q` lists everything, newest first. `highlight` is HTML-escaped text with matches wrapped in `<mark>`.",
        "operationId": "Search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contentType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/search/reindex": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Rebuild the search index from the content source",
        "description": "Builds a fresh index and swaps it in atomically; search keeps serving the previous contents until the rebuild has succeeded. Requires the `X-Reindex-Secret` header (`Search:ReindexSecret`).",
        "operationId": "Reindex",
        "parameters": [
          {
            "name": "X-Reindex-Secret",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReindexResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "required": [
          "publishDate",
          "tags",
          "bodyHtml",
          "readingTimeMinutes"
        ],
        "type": "object",
        "properties": {
          "publishDate": {
            "type": "string",
            "format": "date"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bodyHtml": {
            "type": "string"
          },
          "readingTimeMinutes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ArticleSummary": {
        "required": [
          "id",
          "path",
          "title",
          "summary",
          "image",
          "publishDate",
          "tags"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "image": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Image"
              }
            ]
          },
          "publishDate": {
            "type": "string",
            "format": "date"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Block": {
        "required": [
          "type"
        ],
        "type": "object",
        "oneOf": [
          {
            "$ref": "#/components/schemas/BlockHeroBlock"
          },
          {
            "$ref": "#/components/schemas/BlockCtaBlock"
          },
          {
            "$ref": "#/components/schemas/BlockLatestArticlesBlock"
          },
          {
            "$ref": "#/components/schemas/BlockArticleListBlock"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "hero": "#/components/schemas/BlockHeroBlock",
            "cta": "#/components/schemas/BlockCtaBlock",
            "latestArticles": "#/components/schemas/BlockLatestArticlesBlock",
            "articleList": "#/components/schemas/BlockArticleListBlock"
          }
        }
      },
      "BlockArticleListBlock": {
        "required": [
          "heading",
          "pageSize",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "articleList"
            ],
            "type": "string"
          },
          "heading": {
            "type": [
              "null",
              "string"
            ]
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BlockCtaBlock": {
        "required": [
          "heading",
          "text",
          "link",
          "style",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "cta"
            ],
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "link": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Link"
              }
            ]
          },
          "style": {
            "$ref": "#/components/schemas/CtaStyle"
          }
        }
      },
      "BlockHeroBlock": {
        "required": [
          "heading",
          "subheading",
          "image",
          "cta",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "hero"
            ],
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "subheading": {
            "type": [
              "null",
              "string"
            ]
          },
          "image": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Image"
              }
            ]
          },
          "cta": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Link"
              }
            ]
          }
        }
      },
      "BlockLatestArticlesBlock": {
        "required": [
          "heading",
          "tag",
          "articles",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "latestArticles"
            ],
            "type": "string"
          },
          "heading": {
            "type": [
              "null",
              "string"
            ]
          },
          "tag": {
            "type": [
              "null",
              "string"
            ]
          },
          "articles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleSummary"
            }
          }
        }
      },
      "ComponentStatus": {
        "required": [
          "name",
          "displayName",
          "status",
          "durationMs"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthState"
          },
          "durationMs": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ContentSyncResult": {
        "required": [
          "id",
          "action"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      },
      "ContentWebhookPayload": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "CtaStyle": {
        "enum": [
          "primary",
          "secondary"
        ]
      },
      "FacetCount": {
        "required": [
          "value",
          "count"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FocalPoint": {
        "required": [
          "left",
          "top"
        ],
        "type": "object",
        "properties": {
          "left": {
            "type": "number",
            "format": "double"
          },
          "top": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "HealthState": {
        "enum": [
          "healthy",
          "degraded",
          "unhealthy"
        ]
      },
      "Image": {
        "required": [
          "url",
          "alt",
          "width",
          "height",
          "focalPoint",
          "srcset"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": [
              "null",
              "string"
            ]
          },
          "width": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "height": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "focalPoint": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FocalPoint"
              }
            ]
          },
          "srcset": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageRendition"
            }
          }
        }
      },
      "ImageRendition": {
        "required": [
          "width",
          "url"
        ],
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "Link": {
        "required": [
          "url",
          "title",
          "target"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "target": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "NavItem": {
        "required": [
          "id",
          "name",
          "path",
          "children"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NavItem"
            }
          }
        }
      },
      "Page": {
        "required": [
          "id",
          "contentType",
          "path",
          "name",
          "title",
          "summary",
          "image",
          "blocks",
          "article",
          "culture",
          "updatedAt",
          "properties"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "image": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Image"
              }
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          },
          "article": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Article"
              }
            ]
          },
          "culture": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "properties": {
            "type": "object",
            "additionalProperties": { }
          }
        }
      },
      "PagedOfArticleSummary": {
        "required": [
          "page",
          "pageSize",
          "total",
          "items"
        ],
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleSummary"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReindexResult": {
        "required": [
          "indexed"
        ],
        "type": "object",
        "properties": {
          "indexed": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SearchFacets": {
        "required": [
          "contentTypes",
          "tags",
          "years"
        ],
        "type": "object",
        "properties": {
          "contentTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetCount"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetCount"
            }
          },
          "years": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacetCount"
            }
          }
        }
