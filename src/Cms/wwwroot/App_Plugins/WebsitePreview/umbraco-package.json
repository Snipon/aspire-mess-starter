{
  "$schema": "../../../umbraco-package-schema.json",
  "name": "Website preview",
  "version": "1.0.0",
  "extensions": [
    {
      "type": "workspaceAction",
      "kind": "default",
      "alias": "Headless.WorkspaceAction.Document.SaveAndPreview",
      "name": "Save and preview on the website",
      "overwrites": "Umb.WorkspaceAction.Document.SaveAndPreview",
      "weight": 90,
      "api": "/App_Plugins/WebsitePreview/save-and-preview.action.js",
      "meta": {
        "label": "#buttons_saveAndPreview"
      },
      "conditions": [
        { "alias": "Umb.Condition.WorkspaceAlias", "match": "Umb.Workspace.Document" },
        { "alias": "Umb.Condition.EntityIsNotTrashed" }
      ]
    }
  ]
}
