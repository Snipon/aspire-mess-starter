# Reverse proxy cache in front of the Astro web app (the "web-cache" resource in apphost.cs). The nginx image renders
# this template to /etc/nginx/nginx.conf at startup (NGINX_ENVSUBST_OUTPUT_DIR), substituting ${WEB_UPSTREAM} (the
# web app's URL).
#
# What is cached and for how long is decided by the web app's Cache-Control header (src/Web/src/middleware.ts):
# s-maxage, stale-while-revalidate and stale-if-error are honoured, responses with no-store/no-cache/private or
# Set-Cookie are not cached. The X-Cache-Status response header shows HIT, MISS, STALE, UPDATING, EXPIRED or BYPASS.
#
# POST /_purge with the X-Purge-Secret header (CACHE_PURGE_SECRET) invalidates every cached page at once (cache.js).
# The API calls it after each content webhook (src/Api/Caching/WebCachePurger.cs).

load_module modules/ngx_http_js_module.so;

# Read by cache.js; nginx hides all other environment variables from its workers.
env CACHE_PURGE_SECRET;

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    keepalive_timeout 65;

    js_import cache from /etc/nginx/templates/cache.js;
    # Shared by all workers: the current cache generation (see cache.js).
    js_shared_dict_zone zone=cache:32k type=number;
    js_set $cache_generation cache.generation;

    proxy_cache_path /var/cache/nginx/web levels=1:2 keys_zone=web:10m max_size=256m inactive=1d use_temp_path=off;
    # The generation is part of the key, so a purge turns every cached page into a miss; the orphaned entries are
    # evicted by max_size/inactive.
    proxy_cache_key "$cache_generation:$scheme$proxy_host$request_uri";

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8080;

        location = /_purge {
            js_content cache.purge;
        }

        location / {
            proxy_pass ${WEB_UPSTREAM};
            proxy_http_version 1.1;

            # Astro builds absolute URLs (Astro.url) from these.
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket upgrade for the Vite dev server's hot reload (never cached).
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_cache web;
            proxy_cache_methods GET HEAD;
            # One request per URL fills the cache; concurrent ones wait for it instead of hitting the web app.
            proxy_cache_lock on;
            proxy_cache_lock_timeout 5s;
            # Refresh in the background while serving the stale copy (stale-while-revalidate).
            proxy_cache_background_update on;
            proxy_cache_revalidate on;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            # Bypass the cache on request: curl -H 'Pragma: no-cache' (the fresh response still replaces the entry).
            proxy_cache_bypass $http_pragma;

            add_header X-Cache-Status $upstream_cache_status always;
        }
    }
}
