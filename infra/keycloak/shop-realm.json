{
  "realm": "shop",
  "displayName": "Aspire Test shop",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "clients": [
    {
      "clientId": "web",
      "name": "Shop",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${WEB_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8082/auth/callback"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:8082/*", "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["basic", "profile", "email"],
      "protocolMappers": [
        {
          "name": "shop-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "shop-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ]
}
