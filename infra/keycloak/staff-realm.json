{
  "realm": "staff",
  "displayName": "Aspire Test staff",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administers the CMS, the shop and the logs" },
      { "name": "editor", "description": "Edits content in the CMS" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "${STAFF_ADMIN_EMAIL}",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "${STAFF_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["default-roles-staff", "admin"]
    }
  ],
  "clientScopes": [
    {
      "name": "roles-claim",
      "description": "Realm roles as a flat 'roles' claim (like Entra ID app roles)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "cms",
      "name": "Umbraco backoffice",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CMS_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:28048/umbraco-signin-oidc", "https://localhost:44350/umbraco-signin-oidc"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:28048/*##https://localhost:44350/*" },
      "defaultClientScopes": ["profile", "email", "roles-claim"]
    },
    {
      "clientId": "commerce",
      "name": "Drupal Commerce admin",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${COMMERCE_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8081/openid-connect/sso"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:8081/*" },
      "defaultClientScopes": ["profile", "email", "roles-claim"]
    },
    {
      "clientId": "seq",
      "name": "Seq (oauth2-proxy)",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SEQ_OIDC_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5341/oauth2/callback"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:5341/*" },
      "defaultClientScopes": ["profile", "email", "roles-claim"]
    }
  ]
}
